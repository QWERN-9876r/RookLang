// decorator-wrappers.js

import { $$content, $$element } from "rooklang/runtime";

// <Product>
let $$product1;
{
  const name = "Guava";
  const price = 3;
  let $$folded$title = name;
  let $$folded$open = true;

  let $$quantity$count = 0;

  function $$quantity$add() {
    $$quantity$count++;
    $$updateQuantity$count4();
  }

  const $$quantityBadge$content = $$element("p");
  const $$button5 = $$element("button");
  $$button5.addEventListener("click", () => {
    $$quantity$add();
  });
  $$button5.append("Take one");
  $$quantityBadge$content.append("Price: ", price, " ", $$button5);
  const $$folded$content = $$element("div");
  const $$p6 = $$element("p");
  const $$text7 = document.createTextNode($$quantity$count);
  $$p6.append("Taken: ", $$text7);
  $$folded$content.append($$quantityBadge$content, $$p6);
  const $$section8 = $$element("section", { className: "card" });
  const $$h39 = $$element("h3");
  $$h39.addEventListener("click", () => {
    $$folded$open = !$$folded$open;
    $$updateFolded$open3();
  });
  const $$text10 = document.createTextNode($$folded$open ? "▾" : "▸");
  const $$text11 = document.createTextNode($$folded$title);
  $$h39.append($$text10, " ", $$text11);
  const [$$content12, $$updateContent12] = $$content(() => $$folded$open ? $$folded$content : null);
  $$section8.append($$h39, $$content12);

  function $$updateFolded$open3() {
    $$text10.data = $$folded$open ? "▾" : "▸";
    $$updateContent12();
  }

  function $$updateQuantity$count4() {
    if (!$$product1) return;
    $$text7.data = $$quantity$count;
  }

  $$product1 = $$section8;
}
