// uploads.js

import { $$Channel, $$element, $$list, $$mount, $$style } from "rooklang/runtime";

const $$styles = [];

$$style($$styles, "rook-uploads-1bdxs0j", `.uploads.rook-uploads-1bdxs0j {
  display: grid;
  gap: 12px;
  max-width: 480px;
}
.top.rook-uploads-1bdxs0j {
  display: flex;
  align-items: center;
  gap: 12px;
}
.summary.rook-uploads-1bdxs0j {
  color: #ffffffb3;
  font-size: 0.9em;
}
button.rook-uploads-1bdxs0j {
  padding: 6px 14px;
  border: 1px solid #f5a524;
  border-radius: 8px;
  background: #f5a524;
  color: #000;
  font: inherit;
  cursor: pointer;
}
button:disabled.rook-uploads-1bdxs0j {
  opacity: 0.4;
  cursor: default;
}
.lanes.rook-uploads-1bdxs0j {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}
.lane.rook-uploads-1bdxs0j {
  display: grid;
  gap: 2px;
  padding: 8px 10px;
  border-top: 3px solid var(--by);
  border-radius: 8px;
  background: #ffffff0d;
  font-size: 0.85em;
