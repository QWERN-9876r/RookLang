}
.files.rook-uploads-1bdxs0j li.rook-uploads-1bdxs0j {
  display: grid;
  grid-template-columns: 1fr auto 150px;
  gap: 12px;
  padding: 6px 12px;
  border-left: 3px solid var(--by, transparent);
  border-radius: 8px;
  background: #ffffff0a;
  font-size: 0.9em;
}
.size.rook-uploads-1bdxs0j {
  color: #ffffff59;
  font-variant-numeric: tabular-nums;
}
.status.rook-uploads-1bdxs0j {
  text-align: right;
}
[data-by="1"].rook-uploads-1bdxs0j {
  --by: #f5a524;
}
[data-by="2"].rook-uploads-1bdxs0j {
  --by: #5eb1ff;
}
[data-by="3"].rook-uploads-1bdxs0j {
  --by: #c48cff;
}
[data-status="queued"].rook-uploads-1bdxs0j .status.rook-uploads-1bdxs0j {
  color: #ffffff59;
}
[data-status="uploading"].rook-uploads-1bdxs0j .status.rook-uploads-1bdxs0j {
  color: #ffffff;
}
[data-status="retrying"].rook-uploads-1bdxs0j .status.rook-uploads-1bdxs0j {
  color: #f5a524;
}
[data-status="done"].rook-uploads-1bdxs0j .status.rook-uploads-1bdxs0j {
