const FILES = [{ name: "beach.jpg", size: 1200 }, { name: "notes.pdf", size: 300 }, { name: "cat.png", size: 800 }, { name: "song.mp3", size: 1500 }, { name: "plan.docx", size: 400 }, { name: "forest.jpg", size: 1100 }, { name: "budget.xlsx", size: 250 }, { name: "talk.mp4", size: 1400 }, { name: "logo.svg", size: 150 }, { name: "city.jpg", size: 900 }];

const TRIES = 3;
const TIMEOUT = 2000;

async function upload(file, signal) {
  const fate = Math.random();
  {
    const [$$case, $$received, $$ok] = await $$Channel.select([{ channel: $$Channel.after(fate < 1 / 6 ? 60_000 : file.size), zero: 0 }, { channel: $$Channel.done(signal) }], false);
    switch ($$case) {
      case 0: {
        break;
      }
      case 1: {
        return new Error("timed out");
      }
    }
  }
  if (fate > 0.75) {
    return new Error("server error");
  }
  return null;
}

function queued(file) {
  return { file, status: "queued", note: "", by: 0 };
}

// <Uploads>
let $$uploads1, $$mountNode2;
{
  let rows = FILES.map(queued);
  let running = false;
  let sent = rows.filter((row) => row.status === "done").length;
  let failed = rows.filter((row) => row.status === "failed").length;

  function set(i, by, status, note) {
    rows = rows.map((row, j) => j === i ? { file: row.file, status, note, by } : row);
    $$updateRows3();
  }

  function busy(by) {
    for (const row of rows) {
      if (row.by === by && (row.status === "uploading" || row.status === "retrying")) {
        return row;
      }
    }
    return null;
  }

  async function deliver(i, by) {
    for (let attempt = 1; attempt <= TRIES; attempt++) {
      set(i, by, "uploading", attempt === 1 ? "" : `try ${attempt}`);
      const start = performance.now();
      const err = await upload(FILES[i], $$Channel.abortSignal($$Channel.after(TIMEOUT)));
      if (err == null) {
        const ms = `${Math.round(performance.now() - start)} ms`;
        set(i, by, "done", attempt === 1 ? ms : `try ${attempt}, ${ms}`);
        return;
      }
      const last = attempt === TRIES;
      set(i, by, last ? "failed" : "retrying", err.message);
      if (!last) {
        await $$Channel.receive($$Channel.after(300 * attempt), false, 0);
      }
    }
  }

  async function uploader(by, queue) {
    for await (const i of $$Channel.range(queue)) {
      await deliver(i, by);
    }
  }

  async function start() {
    running = true;
    $$updateRunning4();
    rows = FILES.map(queued);
    $$updateRows3();
    const queue = $$Channel.make(FILES.length, 0);
    for (let i = 0; i < FILES.length; i++) {
      await $$Channel.send(queue, i);
    }
    $$Channel.close(queue);
    await Promise.all([uploader(1, queue), uploader(2, queue), uploader(3, queue)]);
    running = false;
    $$updateRunning4();
  }

  $$mount(() => $$mountNode2, () => {
    start();
  });

  const $$div5 = $$element("div", { className: "uploads rook-uploads-1bdxs0j" });
  const $$div6 = $$element("div", { className: "top rook-uploads-1bdxs0j" });
  const $$button7 = $$element("button", { disabled: running, className: "rook-uploads-1bdxs0j" });
  $$button7.addEventListener("click", () => {
    start();
  });
  $$button7.append("Upload again");
  const $$span8 = $$element("span", { className: "summary rook-uploads-1bdxs0j" });
  const $$text9 = document.createTextNode(sent);
  const $$text10 = document.createTextNode(failed);
  $$span8.append($$text9, " sent · ", $$text10, " failed");
  $$div6.append($$button7, $$span8);
  const $$div11 = $$element("div", { className: "lanes rook-uploads-1bdxs0j" });
  const [$$for12, $$updateFor12] = $$list(() => [1, 2, 3], (by) => {
    const $$block13 = document.createDocumentFragment();
    let row = busy(by);
    const $$div14 = $$element("div", { className: "lane rook-uploads-1bdxs0j" }, { "data-by": by });
    const $$b15 = $$element("b", { className: "rook-uploads-1bdxs0j" });
    $$b15.append("Uploader ", by);
    const $$span16 = $$element("span", { className: "rook-uploads-1bdxs0j" });
    const $$text17 = document.createTextNode(row != null ? row.file.name : running ? "taking the next" : "done");
    $$span16.append($$text17);
    $$div14.append($$b15, $$span16);
    $$block13.append($$div14);
    return [$$block13, () => {
      row = busy(by);
      $$text17.data = row != null ? row.file.name : running ? "taking the next" : "done";
    }];
  });
  $$div11.append($$for12);
  const $$ul18 = $$element("ul", { className: "files rook-uploads-1bdxs0j" });
  const [$$for19, $$updateFor19] = $$list(() => rows, (row) => {
    const $$block20 = document.createDocumentFragment();
    const $$li21 = $$element("li", { className: "rook-uploads-1bdxs0j" }, { "data-status": row.status, "data-by": row.by });
    const $$span22 = $$element("span", { className: "rook-uploads-1bdxs0j" });
    const $$text23 = document.createTextNode(row.file.name);
    $$span22.append($$text23);
    const $$span24 = $$element("span", { className: "size rook-uploads-1bdxs0j" });
    const $$text25 = document.createTextNode(row.file.size);
    $$span24.append($$text25, " KB");
    const $$span26 = $$element("span", { className: "status rook-uploads-1bdxs0j" });
    const $$text27 = document.createTextNode(row.status);
    const $$text28 = document.createTextNode(row.note === "" ? "" : ` · ${row.note}`);
    $$span26.append($$text27, $$text28);
    $$li21.append($$span22, $$span24, $$span26);
    $$block20.append($$li21);
    return [$$block20, () => {
      $$li21.setAttribute("data-status", row.status);
      $$li21.setAttribute("data-by", row.by);
      $$text23.data = row.file.name;
      $$text25.data = row.file.size;
      $$text27.data = row.status;
      $$text28.data = row.note === "" ? "" : ` · ${row.note}`;
    }];
  });
  $$ul18.append($$for19);
  $$div5.append($$div6, $$div11, $$ul18);

  function $$updateRows3() {
    sent = rows.filter((row) => row.status === "done").length;
    failed = rows.filter((row) => row.status === "failed").length;
    if (!$$uploads1) return;
    $$text9.data = sent;
    $$text10.data = failed;
    $$updateFor12();
    $$updateFor19();
  }

  function $$updateRunning4() {
    if (!$$uploads1) return;
    $$button7.disabled = running;
    $$updateFor12();
  }

  $$uploads1 = $$div5;
  $$mountNode2 = $$uploads1?.nodeType === 11 ? $$uploads1.firstChild : $$uploads1;
}
document.body.append($$uploads1);

// uploads.d.ts

interface File {
    name: string;
    size: number;
}
type Status = "queued" | "uploading" | "retrying" | "done" | "failed";
interface Row {
    file: File;
    status: Status;
    note: string;
    by: number;
}
export {};
