// components.js

import { $$element } from "rooklang/runtime";

const tasks = [{ id: 1, title: "Write the task model", done: true, priority: "normal" }, { id: 2, title: "Build the task board", done: false, priority: "high" }];

const $$ul1 = $$element("ul");
for (const task of tasks) {
  // <TaskRow>
  const $$0 = task;
  let $$taskRow2;
  {
    const task = $$0;
    $$taskRow2 = $$element("li");
    const $$label3 = $$element("label");
    const $$input4 = $$element("input", { type: "checkbox", checked: task.done });
    $$label3.append($$input4, task.title);
    const $$small5 = $$element("small");
    $$small5.append(task.priority);
    $$taskRow2.append($$label3, $$small5);
  }
  $$ul1.append($$taskRow2);
}
document.body.append($$ul1);

// components.d.ts

type Priority = "low" | "normal" | "high";
interface Task {
    id: number;
    title: string;
    done: boolean;
    priority: Priority;
}
export {};
