// queues.js

import { $$Queue } from "rooklang/runtime";

const grid = ["S.#.....", ".##.###.", "....#...", ".##...#E"];
const width = grid[0].length;
const cells = grid.join("");

function shortest() {
  let seen = cells.split("").map(() => false);
  const todo = new $$Queue([{ at: cells.indexOf("S"), steps: 0 }]);
  while (todo.length > 0) {
    const step = todo.shift();
    if (step == null) {
      break;
    }
    if (cells[step.at] === "E") {
      return step.steps;
    }
    const col = step.at % width;
    const left = col > 0 ? step.at - 1 : -1;
    const right = col < width - 1 ? step.at + 1 : -1;
    for (const next of [step.at - width, step.at + width, left, right]) {
      if (next >= 0 && next < cells.length && cells[next] !== "#" && !seen[next]) {
        seen[next] = true;
        todo.push({ at: next, steps: step.steps + 1 });
      }
    }
  }
  return null;
}
console.log("shortest path:", shortest());

const recent = new $$Queue();
for (const page of ["home", "docs", "guide", "playground"]) {
  recent.unshift(page);
  if (recent.length > 3) {
    recent.pop();
  }
}
console.log("recent:", [...recent].join(", "), "| oldest:", recent.at(-1));

// queues.d.ts

interface Step {
    at: number;
    steps: number;
}
export {};
