// streams.js

import { $$Channel, $$goWorker } from "rooklang/runtime";

async function $$startWorker() {
  if (typeof Worker === "function") {
    return new Worker(new URL("./streams.worker.js", import.meta.url), { type: "module" });
  }
  const threads = "node:worker_threads";
  const { Worker: NodeWorker } = await import(/* @vite-ignore */ threads);
  const url = new URL(/* @vite-ignore */ "./streams.worker.js", import.meta.url);
  const code = `import ${JSON.stringify(url.href)};`;
  return new NodeWorker(new URL(`data:text/javascript,${encodeURIComponent(code)}`));
}

const $$go = (name, args) => $$goWorker($$startWorker, name, args);

async function parse(chunks) {
  let text = "";
  let count = 0;
  for await (const chunk of $$Channel.range(chunks)) {
    text += chunk;
    count++;
  }
  return [JSON.parse(text), count];
}

const response = await fetch("https://fakestoreapi.com/products");
const text = response.body?.pipeThrough(new TextDecoderStream());

const [chunks, failed] = $$Channel.fromStream(text, 4, "");
const [products, count] = await $$go("parse", [chunks]);
console.log(`${products.length} products in ${count} chunks`);
console.log("error:", await $$Channel.receive(failed));

const lines = $$Channel.make(0, "");
async function list() {
  for (const product of products.slice(0, 3)) {
    await $$Channel.send(lines, `${product.title}: $${product.price}\n`);
  }
  $$Channel.close(lines);
}
list();
const body = $$Channel.stream(lines).pipeThrough(new TextEncoderStream());
console.log(await new Response(body).text());

// streams.worker.js

import { $$Channel, $$serve } from "rooklang/runtime";

async function parse(chunks) {
  let text = "";
  let count = 0;
  for await (const chunk of $$Channel.range(chunks)) {
    text += chunk;
    count++;
  }
  return [JSON.parse(text), count];
}

const $$goroutines = { parse };
$$serve($$goroutines);

// streams.d.ts

interface Product {
    title: string;
    price: number;
}
export {};
