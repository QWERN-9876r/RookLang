// channel-objects.js

import { $$channels, $$topics } from "rooklang/runtime";

let none = $$channels.EMPTY;
const [n, ok] = await $$channels.receive(none, true, 0);
console.log("from EMPTY:", n, ok);

const lines = $$channels.make(3, "");
await $$channels.send(lines, "one");
await $$channels.send(lines, "two");
console.log("received:", await $$channels.receive(lines));

const channels = [lines, $$channels.make(1, "")];
channels.forEach($$channels.close);
for await (const line of $$channels.range(lines)) {
  console.log("left after close:", line);
}

let quiet = $$topics.EMPTY;
$$topics.publish(quiet, "nobody hears this");

const cart = $$topics.make("guide-objects", 0);
$$topics.publish(cart, 1);
const values = $$topics.listen(cart);
$$topics.close(cart);
const [last, open] = await $$channels.receive(values, true, 0);
console.log("after Topic.close:", last, open);

// channel-objects.d.ts

export {};
