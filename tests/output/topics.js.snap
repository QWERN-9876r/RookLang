// topics.js

import { $$Channel, $$Topic, $$element, $$mount } from "rooklang/runtime";

// <Cart>
let $$cart1, $$mountNode2;
{
  let items = [];
  const cart = $$Topic.make("guide-cart", null);

  function apply(e) {
    if (e.kind === "add") {
      items.push(e.title);
      $$updateItems3();
    } else {
      items = [];
      $$updateItems3();
    }
  }

  function change(e) {
    apply(e);
    $$Topic.publish(cart, e);
  }

  async function follow() {
    for await (const e of $$Channel.range($$Topic.listen(cart))) {
      apply(e);
    }
  }

  const $$cleanups4 = [];
  $$mount(() => $$mountNode2, () => {
    follow();
    $$cleanups4.push(() => $$Channel.close(cart));
  }, $$cleanups4);

  const $$div5 = $$element("div", { className: "card" });
  const $$button6 = $$element("button");
  $$button6.addEventListener("click", () => {
    change({ kind: "add", title: `Book ${items.length + 1}` });
  });
  $$button6.append("Add a book");
  const $$button7 = $$element("button");
  $$button7.addEventListener("click", () => {
    change({ kind: "clear", title: "" });
  });
  $$button7.append("Clear");
  const $$p8 = $$element("p");
  const $$text9 = document.createTextNode(items.length === 0 ? "nothing" : items.join(", "));
  $$p8.append("In the cart: ", $$text9);
  $$div5.append($$button6, $$button7, $$p8);

  function $$updateItems3() {
    if (!$$cart1) return;
    $$text9.data = items.length === 0 ? "nothing" : items.join(", ");
  }

  $$cart1 = $$div5;
  $$mountNode2 = $$cart1?.nodeType === 11 ? $$cart1.firstChild : $$cart1;
}
document.body.append($$cart1);

// topics.d.ts

interface CartEvent {
    kind: "add" | "clear";
    title: string;
}
export {};
