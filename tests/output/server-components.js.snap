// server-components.js

import { reply, serve } from "rooklang/server";
import { $$attr, $$html } from "rooklang/runtime";

const TASKS = [{ id: "model", title: "Define the task model", done: true, priority: "normal" }, { id: "board", title: "Render the task board", done: false, priority: "high" }];

async function loadTasks() {
  return TASKS;
}

async function $$Layout({ title, children }, $$ctx) {
  return await $$html`<!doctype html><html lang="en"><head><title>${title}</title></head><body><main>${children?.()}</main></body></html>`;
}

async function $$TaskRows({ tasks }, $$ctx) {
  return $$html`<ul>${(() => {
    const $$parts0 = [];
    for (const task of tasks) {
      $$parts0.push($$html`<li><label><input type="checkbox"${$$attr("checked", task.done)}>${task.title} <small>${task.priority}</small></label></li>`);
    }
    return $$parts0;
  })()}</ul>`;
}

async function $$TaskPage($$props, $$ctx) {
  const tasks = await loadTasks();
  return await $$Layout({ title: "Task board", children: () => $$html`<h1>Task board</h1>${$$TaskRows({ tasks: tasks }, $$ctx)}` }, $$ctx);
}

async function $$App({ request }, $$ctx) {
  const path = new URL(request.url).pathname;
  if (path === "/api/tasks") {
    return await loadTasks();
  }
  if (path === "/") {
    return await $$TaskPage({}, $$ctx);
  }
  return reply("Not found", { status: 404 });
}

serve($$App, { port: 3000 });

// server-components.d.ts

import { reply, serve } from "rooklang/server";
type Priority = "low" | "normal" | "high";
interface Task {
    id: string;
    title: string;
    done: boolean;
    priority: Priority;
}
export {};
