// orders.js

import { $$branches, $$decodeJson, $$element, $$list, $$style, $$type } from "rooklang/runtime";

const $$styles = [];

const $$typeOrder = $$type("Order", () => ({
  id: "number",
  customer: $$typeCustomer,
  items: { array: $$typeItem },
  status: { literal: ["new", "paid", "sent"] },
  delivery: { union: [$$typePickup, $$typeCourier] },
  note: { nullable: "string" },
}));
const $$typeCustomer = $$type("Customer", () => ({
  name: "string",
  email: "string",
}));
const $$typeItem = $$type("Item", () => ({
  name: "string",
  qty: "number",
  price: "number",
}));
const $$typePickup = $$type("Pickup", () => ({
  kind: { literal: ["pickup"] },
  shop: "string",
}));
const $$typeCourier = $$type("Courier", () => ({
  kind: { literal: ["courier"] },
  address: "string",
  floor: { nullable: "number" },
}));

$$style($$styles, "rook-orders-1l85dq6", `.orders.rook-orders-1l85dq6 {
  display: grid;
  gap: 12px;
  max-width: 480px;
}
.samples.rook-orders-1l85dq6 {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.samples.rook-orders-1l85dq6 button.rook-orders-1l85dq6 {
  padding: 4px 10px;
  border: 1px solid #ffffff2e;
  border-radius: 999px;
  background: #ffffff0a;
  color: inherit;
  font: inherit;
  font-size: 0.85em;
  cursor: pointer;
}
textarea.rook-orders-1l85dq6 {
  height: 230px;
  padding: 10px 12px;
  border: 1px solid #ffffff2e;
  border-radius: 10px;
  background: #ffffff0a;
  color: inherit;
  font: 0.8em/1.5 ui-monospace, monospace;
  resize: vertical;
}
.problem.rook-orders-1l85dq6 {
  margin: 0;
  padding: 10px 12px;
  border-left: 3px solid #ff7a7a;
  border-radius: 6px;
  background: #ff7a7a1a;
  color: #ffb3b3;
  font: 0.85em/1.5 ui-monospace, monospace;
}`);
$$style($$styles, "rook-receipt-1nonkdw", `.receipt.rook-receipt-1nonkdw {
  display: grid;
  gap: 6px;
  padding: 12px 14px;
  border-left: 3px solid #6fcf8f;
  border-radius: 6px;
  background: #6fcf8f14;
}
.head.rook-receipt-1nonkdw, .line.rook-receipt-1nonkdw {
  display: flex;
  justify-content: space-between;
}
.status.rook-receipt-1nonkdw {
  color: #6fcf8f;
}
.who.rook-receipt-1nonkdw {
  margin: 0 0 4px;
  color: #ffffff80;
  font-size: 0.85em;
}
.total.rook-receipt-1nonkdw {
  padding-top: 6px;
  border-top: 1px solid #ffffff1a;
  font-weight: 600;
}`);

const COURIER = `"courier", "address": "12 Elm st.", "floor": 3`;

const VALID = `{
  "id": 1042,
  "customer": { "name": "Ann", "email": "ann@example.com" },
  "items": [
    { "name": "Mango", "qty": 2, "price": 2.4 },
    { "name": "Lychee", "qty": 1, "price": 7.5 }
  ],
  "status": "paid",
  "delivery": { "kind": ${COURIER} }
}`;

const SAMPLES = [{ title: "Valid", json: VALID }, { title: "Price as text", json: VALID.replace(`"price": 7.5`, `"price": "7.50"`) }, { title: "Unknown status", json: VALID.replace(`"paid"`, `"lost"`) }, { title: "Pickup", json: VALID.replace(COURIER, `"pickup", "shop": "Main st."`) }, { title: "Unknown delivery", json: VALID.replace(`"courier"`, `"drone"`) }, { title: "No email", json: VALID.replace(`, "email": "ann@example.com"`, "") }, { title: "Cut off", json: VALID.slice(0, 140) }];

function check(json) {
  const [order, err] = $$decodeJson(json, $$typeOrder);
  if (err != null) {
    return { order: null, problem: err.message };
  }
  return { order, problem: "" };
}

// <Orders>
let $$orders1;
{
  let json = VALID;
  let checked = check(json);
  let order = checked.order;

  const $$div3 = $$element("div", { className: "orders rook-orders-1l85dq6" });
  const $$div4 = $$element("div", { className: "samples rook-orders-1l85dq6" });
  for (const sample of SAMPLES) {
    const $$button5 = $$element("button", { className: "rook-orders-1l85dq6" });
    $$button5.addEventListener("click", () => {
      json = sample.json;
      $$updateJson2();
    });
    $$button5.append(sample.title);
    $$div4.append($$button5);
  }
  const $$textarea6 = $$element("textarea", { className: "rook-orders-1l85dq6" }, { spellcheck: false });
  $$textarea6.value = json;
  $$textarea6.addEventListener("input", () => {
    json = $$textarea6.value;
    $$updateJson2();
  });
  const [$$if7, $$updateIf7] = $$branches(() => order != null ? 0 : 1, [() => {
    const $$block8 = document.createDocumentFragment();
    // <Receipt>
    const $$0 = order;
    let $$receipt9;
    let $$setOrder10;
    {
      let order = $$0;
      let total = order.items.reduce((sum, item) => sum + item.qty * item.price, 0);

      const $$div12 = $$element("div", { className: "receipt rook-receipt-1nonkdw" });
      const $$div13 = $$element("div", { className: "head rook-receipt-1nonkdw" });
      const $$b14 = $$element("b", { className: "rook-receipt-1nonkdw" });
      const $$text15 = document.createTextNode(order.id);
      $$b14.append("Order #", $$text15);
      const $$span16 = $$element("span", { className: "status rook-receipt-1nonkdw" });
      const $$text17 = document.createTextNode(order.status);
      $$span16.append($$text17);
      $$div13.append($$b14, $$span16);
      const $$p18 = $$element("p", { className: "who rook-receipt-1nonkdw" });
      const $$text19 = document.createTextNode(order.customer.name);
      const $$text20 = document.createTextNode(order.customer.email);
      $$p18.append($$text19, " · ", $$text20);
      const [$$if21, $$updateIf21] = $$branches(() => order.delivery.kind === "pickup" ? 0 : order.delivery.floor != null ? 1 : 2, [() => {
        const $$block22 = document.createDocumentFragment();
        const $$p23 = $$element("p", { className: "who rook-receipt-1nonkdw" });
        const $$text24 = document.createTextNode(order.delivery.shop);
        $$p23.append("Pickup at ", $$text24);
        $$block22.append($$p23);
        return [$$block22, () => {
          $$text24.data = order.delivery.shop;
        }];
      }, () => {
        const $$block25 = document.createDocumentFragment();
        const $$p26 = $$element("p", { className: "who rook-receipt-1nonkdw" });
        const $$text27 = document.createTextNode(order.delivery.address);
        const $$text28 = document.createTextNode(order.delivery.floor);
        $$p26.append("Courier to ", $$text27, ", floor ", $$text28);
        $$block25.append($$p26);
        return [$$block25, () => {
          $$text27.data = order.delivery.address;
          $$text28.data = order.delivery.floor;
        }];
      }, () => {
        const $$block29 = document.createDocumentFragment();
        const $$p30 = $$element("p", { className: "who rook-receipt-1nonkdw" });
        const $$text31 = document.createTextNode(order.delivery.address);
        $$p30.append("Courier to ", $$text31);
        $$block29.append($$p30);
        return [$$block29, () => {
          $$text31.data = order.delivery.address;
        }];
      }]);
      const [$$for32, $$updateFor32] = $$list(() => order.items, (item) => {
        const $$block33 = document.createDocumentFragment();
        const $$div34 = $$element("div", { className: "line rook-receipt-1nonkdw" });
        const $$span35 = $$element("span", { className: "rook-receipt-1nonkdw" });
        const $$text36 = document.createTextNode(item.qty);
        const $$text37 = document.createTextNode(item.name);
        $$span35.append($$text36, " × ", $$text37);
        const $$span38 = $$element("span", { className: "rook-receipt-1nonkdw" });
        const $$text39 = document.createTextNode((item.qty * item.price).toFixed(2));
        $$span38.append("€", $$text39);
        $$div34.append($$span35, $$span38);
        $$block33.append($$div34);
        return [$$block33, () => {
          $$text36.data = item.qty;
          $$text37.data = item.name;
          $$text39.data = (item.qty * item.price).toFixed(2);
        }];
      });
      const $$div40 = $$element("div", { className: "line total rook-receipt-1nonkdw" });
      const $$span41 = $$element("span", { className: "rook-receipt-1nonkdw" });
      $$span41.append("Total");
      const $$span42 = $$element("span", { className: "rook-receipt-1nonkdw" });
      const $$text43 = document.createTextNode(total.toFixed(2));
      $$span42.append("€", $$text43);
      $$div40.append($$span41, $$span42);
      const [$$if44, $$updateIf44] = $$branches(() => order.note != null ? 0 : -1, [() => {
        const $$block45 = document.createDocumentFragment();
        const $$p46 = $$element("p", { className: "who rook-receipt-1nonkdw" });
        const $$text47 = document.createTextNode(order.note);
        $$p46.append($$text47);
        $$block45.append($$p46);
        return [$$block45, () => {
          $$text47.data = order.note;
        }];
      }]);
      $$div12.append($$div13, $$p18, $$if21, $$for32, $$div40, $$if44);

      $$setOrder10 = ($$order) => {
        order = $$order;
        total = order.items.reduce((sum, item) => sum + item.qty * item.price, 0);
        $$text15.data = order.id;
        $$text17.data = order.status;
        $$text19.data = order.customer.name;
        $$text20.data = order.customer.email;
        $$updateIf21();
        $$updateFor32();
        $$text43.data = total.toFixed(2);
        $$updateIf44();
      };

      $$receipt9 = $$div12;
    }
    $$block8.append($$receipt9);
    return [$$block8, () => {
      $$setOrder10(order);
    }];
  }, () => {
    const $$block48 = document.createDocumentFragment();
    const $$p49 = $$element("p", { className: "problem rook-orders-1l85dq6" });
    const $$text50 = document.createTextNode(checked.problem);
    $$p49.append($$text50);
    $$block48.append($$p49);
    return [$$block48, () => {
      $$text50.data = checked.problem;
    }];
  }]);
  $$div3.append($$div4, $$textarea6, $$if7);

  function $$updateJson2() {
    checked = check(json);
    order = checked.order;
    if ($$textarea6.value !== json) $$textarea6.value = json;
    $$updateIf7();
  }

  $$orders1 = $$div3;
}
document.body.append($$orders1);

// orders.d.ts

interface Customer {
    name: string;
    email: string;
}
interface Item {
    name: string;
    qty: number;
    price: number;
}
interface Pickup {
    kind: "pickup";
    shop: string;
}
interface Courier {
    kind: "courier";
    address: string;
    floor?: number | null;
}
interface Order {
    id: number;
    customer: Customer;
    items: Item[];
    status: "new" | "paid" | "sent";
    delivery: Pickup | Courier;
    note?: string | null;
}
interface Checked {
    order?: Order | null;
    problem: string;
}
export {};
