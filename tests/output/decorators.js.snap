// <Spinner>
let $$spinner17, $$mountNode18;
{
  const $$ticker$interval = 150;
  let $$ticker$ticks = 0;
  let $$ticker$running = true;

  function $$ticker$toggle() {
    $$ticker$running = !$$ticker$running;
  }

  $$mount(() => $$mountNode18, () => {
    const timer = setInterval(() => {
      if ($$ticker$running) {
        $$ticker$ticks++;
        $$text22.data = FRAMES[$$ticker$ticks % FRAMES.length];
      }
    }, $$ticker$interval);
    return () => clearInterval(timer);
  });

  const $$p21 = $$element("p", { className: "card" });
  const $$text22 = document.createTextNode(FRAMES[$$ticker$ticks % FRAMES.length]);
  $$p21.append($$text22);
  $$spinner17 = $$p21;
  $$mountNode18 = $$spinner17?.nodeType === 11 ? $$spinner17.firstChild : $$spinner17;
}
document.body.append($$stopwatch1, $$stopwatch9, $$spinner17);

// decorators.d.ts

export {};
