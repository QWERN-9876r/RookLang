// decorators.js

import { $$element, $$mount } from "rooklang/runtime";

const FRAMES = ["◐", "◓", "◑", "◒"];

// <Stopwatch>
let $$stopwatch1, $$mountNode2;
{
  const label = "Tea";
  const $$ticker$interval = 1000;
  let $$ticker$ticks = 0;
  let $$ticker$running = true;

  function $$ticker$toggle() {
    $$ticker$running = !$$ticker$running;
    $$updateTicker$running4();
  }

  const $$cleanups5 = [];
  $$mount(() => $$mountNode2, () => {
    const timer = setInterval(() => {
      if ($$ticker$running) {
        $$ticker$ticks++;
        $$text7.data = $$ticker$ticks;
      }
    }, $$ticker$interval);
    $$cleanups5.push(() => clearInterval(timer));
  }, $$cleanups5);

  const $$p6 = $$element("p", { className: "card" });
  const $$text7 = document.createTextNode($$ticker$ticks);
  const $$button8 = $$element("button");
  $$button8.addEventListener("click", () => {
    $$ticker$toggle();
  });
  const $$text9 = document.createTextNode($$ticker$running ? "Pause" : "Go on");
  $$button8.append($$text9);
  $$p6.append(label, ": ", $$text7, " s", $$button8);

  function $$updateTicker$running4() {
    if (!$$stopwatch1) return;
    $$text9.data = $$ticker$running ? "Pause" : "Go on";
  }

  $$stopwatch1 = $$p6;
  $$mountNode2 = $$stopwatch1?.nodeType === 11 ? $$stopwatch1.firstChild : $$stopwatch1;
}
