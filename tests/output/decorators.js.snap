// <Spinner>
let $$spinner19, $$mountNode20;
{
  const $$ticker$interval = 150;
  let $$ticker$ticks = 0;
  let $$ticker$running = true;

  function $$ticker$toggle() {
    $$ticker$running = !$$ticker$running;
  }

  const $$cleanups23 = [];
  $$mount(() => $$mountNode20, () => {
    const timer = setInterval(() => {
      if ($$ticker$running) {
        $$ticker$ticks++;
        $$text25.data = FRAMES[$$ticker$ticks % FRAMES.length];
      }
    }, $$ticker$interval);
    $$cleanups23.push(() => clearInterval(timer));
  }, $$cleanups23);

  const $$p24 = $$element("p", { className: "card" });
  const $$text25 = document.createTextNode(FRAMES[$$ticker$ticks % FRAMES.length]);
