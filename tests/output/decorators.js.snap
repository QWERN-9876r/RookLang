// decorators.js

import { $$element, $$mount } from "rooklang/runtime";

const FRAMES = ["◐", "◓", "◑", "◒"];

// <Stopwatch>
let $$stopwatch1, $$mountNode2;
{
  const label = "Tea";
  const $$ticker$interval = 1000;
  let $$ticker$ticks = 0;
  let $$ticker$running = true;

  function $$ticker$toggle() {
    $$ticker$running = !$$ticker$running;
    $$updateTicker$running4();
  }

  $$mount(() => $$mountNode2, () => {
    const timer = setInterval(() => {
      if ($$ticker$running) {
        $$ticker$ticks++;
        $$text6.data = $$ticker$ticks;
      }
    }, $$ticker$interval);
    return () => clearInterval(timer);
  });

  const $$p5 = $$element("p", { className: "card" });
  const $$text6 = document.createTextNode($$ticker$ticks);
  const $$button7 = $$element("button");
  $$button7.addEventListener("click", () => {
    $$ticker$toggle();
  });
  const $$text8 = document.createTextNode($$ticker$running ? "Pause" : "Go on");
  $$button7.append($$text8);
  $$p5.append(label, ": ", $$text6, " s", " ", $$button7);

  function $$updateTicker$running4() {
    if (!$$stopwatch1) return;
    $$text8.data = $$ticker$running ? "Pause" : "Go on";
  }

  $$stopwatch1 = $$p5;
  $$mountNode2 = $$stopwatch1?.nodeType === 11 ? $$stopwatch1.firstChild : $$stopwatch1;
}
// <Stopwatch>
