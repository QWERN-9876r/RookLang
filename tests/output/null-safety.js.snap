// null-safety.js

const todos = [{ title: "Buy guavas", done: false }];

const todo = todos.find((t) => t.title === "Buy guavas");

if (todo != null) {
  console.log(todo.done);
}

const first = todos.find((t) => !t.done);
console.log(first.title, todo?.title ?? "none");

function fail(message) {
  throw new Error(message);
}
if (todo == null) {
  fail("no such task");
}
console.log(todo.title);

// null-safety.d.ts

interface Todo {
    title: string;
    done: boolean;
}
export {};
