// channels.js

import { $$channels, $$goWorker } from "rooklang/runtime";

async function $$startWorker() {
  if (typeof Worker === "function") {
    return new Worker(new URL("./channels.worker.js", import.meta.url), { type: "module" });
  }
  const threads = "node:worker_threads";
  const { Worker: NodeWorker } = await import(/* @vite-ignore */ threads);
  const url = new URL(/* @vite-ignore */ "./channels.worker.js", import.meta.url);
  const code = `import ${JSON.stringify(url.href)};`;
  return new NodeWorker(new URL(`data:text/javascript,${encodeURIComponent(code)}`));
}

const $$go = (name, args) => $$goWorker($$startWorker, name, args);

async function square(id, jobs, results) {
  for await (const n of $$channels.range(jobs)) {
    await $$channels.send(results, `goroutine ${id}: ${n}² = ${n * n}`);
  }
}

const jobs = $$channels.make(10, 0);
const results = $$channels.make(0, "");

$$go("square", [1, jobs, results]);
$$go("square", [2, jobs, results]);

for (let n = 1; n <= 6; n++) {
  await $$channels.send(jobs, n);
}
$$channels.close(jobs);

for (let i = 0; i < 6; i++) {
  console.log(await $$channels.receive(results, false, ""));
}
$$channels.close(results);

const [n, ok] = await $$channels.receive(jobs, true, 0);
console.log("after close:", n, ok);

// channels.worker.js

import { $$channels, $$serve } from "rooklang/runtime";

async function square(id, jobs, results) {
  for await (const n of $$channels.range(jobs)) {
    await $$channels.send(results, `goroutine ${id}: ${n}² = ${n * n}`);
  }
}

const $$goroutines = { square };
$$serve($$goroutines);

// channels.d.ts

export {};
