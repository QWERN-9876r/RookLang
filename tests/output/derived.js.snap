// derived.js

import { $$element } from "rooklang/runtime";

// <Basket>
let $$basket1;
{
  let prices = [3, 2];
  let total = prices.reduce((sum, price) => sum + price, 0);
  const $$computeNote3 = () => {
    const room = 10 - total;
    if (room <= 0) {
      return "That is a lot of guavas";
    }
    return `There is room for ${room} more`;
  };
  let note = $$computeNote3();

  const $$effect4 = () => {
    console.log("total:", total);
  };

  const $$div5 = $$element("div");
  const $$button6 = $$element("button");
  $$button6.addEventListener("click", () => {
    prices.push(3);
    $$updatePrices2();
  });
  $$button6.append("Add a guava");
  const $$p7 = $$element("p");
  const $$text8 = document.createTextNode(prices.length);
  const $$text9 = document.createTextNode(total);
  const $$text10 = document.createTextNode(note);
  $$p7.append($$text8, " fruits for ", $$text9, ". ", $$text10);
  $$div5.append($$button6, $$p7);

  function $$updatePrices2() {
    total = prices.reduce((sum, price) => sum + price, 0);
    note = $$computeNote3();
    $$text8.data = prices.length;
    $$text9.data = total;
    $$text10.data = note;
    $$effect4();
  }

  $$basket1 = $$div5;
  $$effect4();
}
document.body.append($$basket1);

// derived.d.ts

export {};
