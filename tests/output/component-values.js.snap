// component-values.js

import { $$dynamic, $$element, $$mount } from "rooklang/runtime";

function $$Greeting(name) {
  let $$greeting2;
  const $$p3 = $$element("p");
  const $$text4 = document.createTextNode(name);
  $$p3.append("Hello, ", $$text4, "!");
  $$greeting2 = $$p3;
  return [$$greeting2, ($$name) => {
    name = $$name;
    $$text4.data = name;
  }];
}

function $$Farewell(name) {
  let $$farewell6, $$mountNode7;
  const $$cleanups8 = [];
  $$mount(() => $$mountNode7, () => {
    console.log("Farewell is shown");
    $$cleanups8.push(() => console.log("Farewell is removed"));
  }, $$cleanups8);
  const $$p9 = $$element("p");
  const $$text10 = document.createTextNode(name);
  $$p9.append("Goodbye, ", $$text10, ".");
  $$farewell6 = $$p9;
  $$mountNode7 = $$farewell6?.nodeType === 11 ? $$farewell6.firstChild : $$farewell6;
  return [$$farewell6, ($$name) => {
    name = $$name;
    $$text10.data = name;
  }];
}

const TABS = [{ title: "Hello", content: $$Greeting }, { title: "Goodbye", content: $$Farewell }];

// <Tabs>
let $$tabs11;
{
  let name = "Ann";
  let Current = $$Greeting;
  const $$div14 = $$element("div");
  const $$input15 = $$element("input");
  $$input15.value = name;
  $$input15.addEventListener("input", () => {
    name = $$input15.value;
    $$updateCurrent17();
  });
  $$div14.append($$input15);
  for (const tab of TABS) {
    const $$button16 = $$element("button");
    $$button16.addEventListener("click", () => {
      Current = tab.content;
      $$updateCurrent17();
    });
    $$button16.append(tab.title);
    $$div14.append($$button16);
  }
  const [$$current17, $$updateCurrent17] = $$dynamic(() => Current, ($$component17) => {
    const $$block18 = document.createDocumentFragment();
    const [$$current19, $$setCurrent19] = $$component17(name);
    $$block18.append($$current19);
    return [$$block18, () => {
      $$setCurrent19(name);
    }];
  });
  $$div14.append($$current17);
  $$tabs11 = $$div14;
}
document.body.append($$tabs11);

// component-values.d.ts

interface Tab {
    title: string;
    content: (name: string) => [Node, ...unknown[]];
}
export {};
