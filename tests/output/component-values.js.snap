// component-values.js

import { $$dynamic, $$element, $$mount } from "rooklang/runtime";

function $$Greeting(name) {
  let $$greeting2;
  const $$p3 = $$element("p");
  const $$text4 = document.createTextNode(name);
  $$p3.append("Hello, ", $$text4, "!");
  $$greeting2 = $$p3;
  return [$$greeting2, ($$name) => {
    name = $$name;
    $$text4.data = name;
  }];
}

function $$Farewell(name) {
  let $$farewell6, $$mountNode7;
  $$mount(() => $$mountNode7, () => {
    console.log("Farewell is shown");
    return () => console.log("Farewell is removed");
  });
  const $$p8 = $$element("p");
  const $$text9 = document.createTextNode(name);
  $$p8.append("Goodbye, ", $$text9, ".");
  $$farewell6 = $$p8;
  $$mountNode7 = $$farewell6?.nodeType === 11 ? $$farewell6.firstChild : $$farewell6;
  return [$$farewell6, ($$name) => {
    name = $$name;
    $$text9.data = name;
  }];
}

const TABS = [{ title: "Hello", content: $$Greeting }, { title: "Goodbye", content: $$Farewell }];

// <Tabs>
let $$tabs10;
{
  let name = "Ann";
  let Current = $$Greeting;
  const $$div13 = $$element("div");
  const $$input14 = $$element("input");
  $$input14.value = name;
  $$input14.addEventListener("input", () => {
    name = $$input14.value;
    $$updateCurrent16();
  });
  $$div13.append($$input14);
  for (const tab of TABS) {
    const $$button15 = $$element("button");
    $$button15.addEventListener("click", () => {
      Current = tab.content;
      $$updateCurrent16();
    });
    $$button15.append(tab.title);
    $$div13.append($$button15);
  }
  const [$$current16, $$updateCurrent16] = $$dynamic(() => Current, ($$component16) => {
    const $$block17 = document.createDocumentFragment();
    const [$$current18, $$setCurrent18] = $$component16(name);
    $$block17.append($$current18);
    return [$$block17, () => {
      $$setCurrent18(name);
    }];
  });
  $$div13.append($$current16);
  $$tabs10 = $$div13;
}
document.body.append($$tabs10);

// component-values.d.ts

interface Tab {
    title: string;
    content: (name: string) => [Node, ...unknown[]];
}
export {};
