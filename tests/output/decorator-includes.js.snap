// decorator-includes.js

import { $$branches, $$element } from "rooklang/runtime";

// <Fruit>
let $$fruit1;
{
  const name = "Mango";
  let $$card$title = name;
  let $$framed$title = $$card$title;
  const $$framed$box = $$element("section", { className: "card" });

  const $$card$box = $$framed$box;
  let $$likes$count = 0;

  function $$likes$like() {
    $$likes$count++;
    $$updateLikes$count4();
  }

  let $$card$count = $$likes$count;
  const $$card$like = $$likes$like;
  let $$card$popular = $$likes$count >= 3;

  function like() {
    $$card$like();
    if ($$card$popular) {
      $$card$box.style.borderColor = "#f5a623";
    }
  }

  const $$framed$content = $$element("p");
  const $$button5 = $$element("button");
  $$button5.addEventListener("click", () => {
    like();
  });
  const $$text6 = document.createTextNode($$card$count);
  $$button5.append("♥ ", $$text6);
  const [$$if7, $$updateIf7] = $$branches(() => $$card$popular ? 0 : -1, [() => {
    const $$block8 = document.createDocumentFragment();
    const $$i9 = $$element("i");
    $$i9.append(" popular");
    $$block8.append($$i9);
    return [$$block8];
  }]);
  $$framed$content.append($$button5, $$if7);
  const $$b10 = $$element("b");
  const $$text11 = document.createTextNode($$framed$title);
  $$b10.append($$text11);
  $$framed$box.append($$b10, $$framed$content);

  function $$updateFramed$title3() {
    if (!$$fruit1) return;
    $$text11.data = $$framed$title;
  }

  function $$updateLikes$count4() {
    $$card$count = $$likes$count;
    $$card$popular = $$likes$count >= 3;
    if (!$$fruit1) return;
    $$text6.data = $$card$count;
    $$updateIf7();
  }

  $$fruit1 = $$framed$box;
}
