// cancel.js

import { $$channels } from "rooklang/runtime";

const controller = new AbortController();
setTimeout(() => controller.abort("the user left"), 100);

{
  const [$$case, $$received, $$ok] = await $$channels.select([{ channel: $$channels.done(controller.signal) }, { channel: $$channels.after(1000), zero: 0 }], false);
  switch ($$case) {
    case 0: {
      const reason = $$received;
      console.log("cancelled:", reason);
      break;
    }
    case 1: {
      console.log("finished");
      break;
    }
  }
}

const stop = $$channels.make(0, false);
const aborting = $$channels.abortSignal(stop);
aborting.addEventListener("abort", () => console.log("aborted:", aborting.aborted));
$$channels.close(stop);

// cancel.d.ts

export {};
