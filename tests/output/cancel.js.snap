// cancel.js

import { $$Channel } from "rooklang/runtime";

const controller = new AbortController();
setTimeout(() => controller.abort("the user left"), 100);

{
  const [$$case, $$received, $$ok] = await $$Channel.select([{ channel: $$Channel.done(controller.signal) }, { channel: $$Channel.after(1000), zero: 0 }], false);
  switch ($$case) {
    case 0: {
      const reason = $$received;
      console.log("cancelled:", reason);
      break;
    }
    case 1: {
      console.log("finished");
      break;
    }
  }
}

const stop = $$Channel.make(0, false);
const aborting = $$Channel.abortSignal(stop);
aborting.addEventListener("abort", () => console.log("aborted:", aborting.aborted));
$$Channel.close(stop);

// cancel.d.ts

export {};
