// component-bind.js

import { $$element, $$list } from "rooklang/runtime";

// <Page>
let $$page1;
{
  let menu = false;
  let todos = [{ title: "Buy guavas", done: false }, { title: "Wash limes", done: true }];
  const $$div4 = $$element("div");
  const $$button5 = $$element("button");
  $$button5.addEventListener("click", () => {
    menu = !menu;
    $$updateMenu2();
  });
  const $$text6 = document.createTextNode(menu ? "Hide" : "Show");
  $$button5.append($$text6, " the menu");
  // <Panel>
  const $$bind7 = ($$value) => {
    menu = $$value;
    $$updateMenu2();
  };
  const $$children8 = document.createDocumentFragment();
  $$children8.append("Close it with ×: the button above knows.");
  let $$panel9;
  let $$setOpen10;
  {
    let open = menu;
    const title = "Menu";
    const children = $$children8;
    const $$section13 = $$element("section", { className: "card", hidden: !open });
    const $$h414 = $$element("h4");
    const $$button15 = $$element("button");
    $$button15.addEventListener("click", () => {
      open = false;
      $$updateOpen12();
    });
    $$button15.append("×");
    $$h414.append(title, " ", $$button15);
    $$section13.append($$h414, children);

    $$setOpen10 = ($$open) => {
      open = $$open;
      $$section13.hidden = !open;
    };

    function $$updateOpen12() {
      $$bind7(open);
      $$section13.hidden = !open;
    }

    $$panel9 = $$section13;
  }
  // <Panel>
  const $$children16 = document.createDocumentFragment();
  $$children16.append("This one keeps its state to itself.");
  let $$panel17;
  {
    let open = true;
    const title = "Note";
    const children = $$children16;
    const $$section19 = $$element("section", { className: "card", hidden: !open });
    const $$h420 = $$element("h4");
    const $$button21 = $$element("button");
    $$button21.addEventListener("click", () => {
      open = false;
      $$section19.hidden = !open;
    });
    $$button21.append("×");
    $$h420.append(title, " ", $$button21);
    $$section19.append($$h420, children);
    $$panel17 = $$section19;
  }
  const [$$for22, $$updateFor22] = $$list(() => todos, (todo) => {
    const $$block23 = document.createDocumentFragment();
    // <Check>
    const $$bind24 = ($$value) => {
      const $$at = todos.indexOf(todo);
      if ($$at !== -1) todos[$$at] = $$value;
      todo = $$value;
      $$updateTodos3();
    };
    const $$0 = todo;
    let $$check25;
    let $$setTodo26;
    {
      let todo = $$0;
      const $$label29 = $$element("label");
      const $$input30 = $$element("input", { type: "checkbox" });
      $$input30.checked = todo.done;
      $$input30.addEventListener("change", () => {
        todo.done = $$input30.checked;
        $$updateTodo28();
      });
      const $$text31 = document.createTextNode(todo.title);
      $$label29.append($$input30, " ", $$text31);

      $$setTodo26 = ($$todo) => {
        todo = $$todo;
        if ($$input30.checked !== todo.done) $$input30.checked = todo.done;
        $$text31.data = todo.title;
      };

      function $$updateTodo28() {
        $$bind24(todo);
        if ($$input30.checked !== todo.done) $$input30.checked = todo.done;
        $$text31.data = todo.title;
      }

      $$check25 = $$label29;
    }
    $$block23.append($$check25);
    return [$$block23, () => {
      $$setTodo26(todo);
    }];
  });
  const $$p32 = $$element("p");
  const $$text33 = document.createTextNode(todos.filter((t) => t.done).length);
  $$p32.append($$text33, " done");
  $$div4.append($$button5, $$panel9, $$panel17, $$for22, $$p32);

  function $$updateMenu2() {
    if (!$$page1) return;
    $$text6.data = menu ? "Hide" : "Show";
    $$setOpen10(menu);
  }

  function $$updateTodos3() {
    if (!$$page1) return;
    $$updateFor22();
    $$text33.data = todos.filter((t) => t.done).length;
  }

  $$page1 = $$div4;
}
document.body.append($$page1);

// component-bind.d.ts

interface Todo {
    title: string;
    done: boolean;
}
export {};
