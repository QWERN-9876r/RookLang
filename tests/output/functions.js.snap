// functions.js

function divmod(a, b) {
  return [Math.floor(a / b), a % b];
}

const [q, r] = divmod(17, 5);
console.log(`17 = 5 × ${q} + ${r}`);

const square = (x) => {
  return x * x;
};
const doubled = [1, 2, 3].map((x) => x * 2);

const factorial = (n) => {
  return n <= 1 ? 1 : n * factorial(n - 1);
};
console.log(square(4), doubled, factorial(5));

function greet(name = "guest", times = 1) {
  return `Hi, ${name}! `.repeat(times);
}

function total(label, ...prices) {
  return `${label}: ${prices.reduce((sum, p) => sum + p, 0)}`;
}
console.log(greet(), greet("Ann", 2), total("cart", 120, 90));

function money(parts, ...values) {
  return parts.map((part, i) => i < values.length ? `${part}${values[i].toFixed(2)} ₽` : part).join("");
}
console.log(money`Guavas cost ${120} and limes ${90}`);

// functions.d.ts

export {};
