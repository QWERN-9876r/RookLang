// todos.js

import { $$branches, $$element, $$list } from "rooklang/runtime";

// <TaskBoard>
let $$taskBoard1;
{
  let tasks = [{ id: 1, title: "Define the task model", done: true, priority: "normal" }, { id: 2, title: "Build the task board", done: false, priority: "high" }];
  let title = "";
  let filter = "open";
  let nextId = 3;

  function add() {
    {
      const trimmed = title.trim();
      if (trimmed !== "") {
        tasks.push({ id: nextId, title: trimmed, done: false, priority: "normal" });
        $$updateTasks2();
        nextId++;
        title = "";
        $$updateTitle3();
      }
    }
  }

  const $$section6 = $$element("section");
  const $$form7 = $$element("form");
  $$form7.addEventListener("submit", (event) => {
    event.preventDefault();
    add();
  });
  const $$input8 = $$element("input", { placeholder: "New task" });
  $$input8.value = title;
  $$input8.addEventListener("input", () => {
    title = $$input8.value;
  });
  const $$button9 = $$element("button");
  $$button9.append("Add task");
  $$form7.append($$input8, $$button9);
  const $$nav10 = $$element("nav", {}, { "aria-label": "Filter tasks" });
  const $$button11 = $$element("button", { type: "button" });
  $$button11.addEventListener("click", () => {
    filter = "all";
    $$updateFilter4();
  });
  $$button11.append("All");
  const $$button12 = $$element("button", { type: "button" });
  $$button12.addEventListener("click", () => {
    filter = "open";
    $$updateFilter4();
  });
  $$button12.append("Open");
  const $$button13 = $$element("button", { type: "button" });
  $$button13.addEventListener("click", () => {
    filter = "done";
    $$updateFilter4();
  });
  $$button13.append("Done");
  $$nav10.append($$button11, $$button12, $$button13);
  const $$p14 = $$element("p");
  const $$text15 = document.createTextNode(tasks.filter((task) => !task.done).length);
  $$p14.append($$text15, " open tasks");
  const $$ul16 = $$element("ul");
  const [$$for17, $$updateFor17] = $$list(() => tasks, (task) => {
    const $$block18 = document.createDocumentFragment();
    const [$$if19, $$updateIf19] = $$branches(() => filter === "all" || filter === "open" && !task.done || filter === "done" && task.done ? 0 : -1, [() => {
      const $$block20 = document.createDocumentFragment();
      const $$li21 = $$element("li");
      const $$label22 = $$element("label");
      const $$input23 = $$element("input", { type: "checkbox", checked: task.done });
      $$input23.addEventListener("change", () => {
        task.done = !task.done;
        $$updateTasks2();
      });
      const $$text24 = document.createTextNode(task.title);
      $$label22.append($$input23, $$text24);
      const $$small25 = $$element("small");
      const $$text26 = document.createTextNode(task.priority);
      $$small25.append($$text26);
      $$li21.append($$label22, $$small25);
      $$block20.append($$li21);
      return [$$block20, () => {
        $$input23.checked = task.done;
        $$text24.data = task.title;
        $$text26.data = task.priority;
      }];
    }]);
    $$block18.append($$if19);
    return [$$block18, ($$index, $$item) => {
      task = $$item;
      $$updateIf19();
    }];
  }, (task) => task.id);
  $$ul16.append($$for17);
  $$section6.append($$form7, $$nav10, $$p14, $$ul16);

  function $$updateTasks2() {
    if (!$$taskBoard1) return;
    $$text15.data = tasks.filter((task) => !task.done).length;
    $$updateFor17();
  }

  function $$updateTitle3() {
    if (!$$taskBoard1) return;
    if ($$input8.value !== title) $$input8.value = title;
  }

  function $$updateFilter4() {
    $$updateFor17();
  }

  $$taskBoard1 = $$section6;
}
document.body.append($$taskBoard1);

// todos.d.ts

type Filter = "all" | "open" | "done";
type Priority = "low" | "normal" | "high";
interface Task {
    id: number;
    title: string;
    done: boolean;
    priority: Priority;
}
export {};
