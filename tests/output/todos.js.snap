// todos.js

import { $$branches, $$element, $$list } from "rooklang/runtime";

// <Todos>
let $$todos1;
{
  let todos = ["Buy guavas", "Learn Rook"];
  let title = "";

  function add() {
    if (title.trim() !== "") {
      todos.push(title.trim());
      $$updateTodos2();
      title = "";
      $$updateTitle3();
    }
  }

  const $$div4 = $$element("div");
  const $$form5 = $$element("form");
  $$form5.addEventListener("submit", (event) => {
    event.preventDefault();
    add();
  });
  const $$input6 = $$element("input", { placeholder: "New task" });
  $$input6.value = title;
  $$input6.addEventListener("input", () => {
    title = $$input6.value;
  });
  const $$button7 = $$element("button");
  $$button7.append("Add");
  $$form5.append($$input6, $$button7);
  const [$$if8, $$updateIf8] = $$branches(() => todos.length === 0 ? 0 : 1, [() => {
    const $$block9 = document.createDocumentFragment();
    const $$p10 = $$element("p");
    $$p10.append("No tasks");
    $$block9.append($$p10);
    return [$$block9];
  }, () => {
    const $$block11 = document.createDocumentFragment();
    const $$ul12 = $$element("ul");
    const [$$for13, $$updateFor13] = $$list(() => todos, (todo, i) => {
      const $$block14 = document.createDocumentFragment();
      const $$li15 = $$element("li");
      const $$text16 = document.createTextNode(todo);
      const $$button17 = $$element("button");
      $$button17.addEventListener("click", () => {
        todos.splice(i, 1);
        $$updateTodos2();
      });
      $$button17.append("×");
      $$li15.append($$text16, " ", $$button17);
      $$block14.append($$li15);
      return [$$block14, ($$index) => {
        i = $$index;
        $$text16.data = todo;
      }];
    });
    $$ul12.append($$for13);
    $$block11.append($$ul12);
    return [$$block11, () => {
      $$updateFor13();
    }];
  }]);
  $$div4.append($$form5, $$if8);

  function $$updateTodos2() {
    if (!$$todos1) return;
    $$updateIf8();
  }

  function $$updateTitle3() {
    if (!$$todos1) return;
    if ($$input6.value !== title) $$input6.value = title;
  }

  $$todos1 = $$div4;
}
document.body.append($$todos1);

// todos.d.ts

export {};
