// RookUI LinkButton: a link that looks like a Button. The attributes of the element go on it
// through ...attrs.

import styles from "./button.module.css"
import { Icon, IconName } from "./icon.rk"
import { ButtonKind, ButtonSize } from "./button.rk"

export comp LinkButton(
    href string,
    kind ButtonKind = "secondary",
    size ButtonSize = "md",
    icon ?IconName = null,
    children Content,
    ...attrs
) {
    return <a class={[styles.button, styles[kind], styles[size]]} href={href} {...attrs}>
        {icon != null ? <Icon name={icon} /> : null}
        {children}
    </a>
}
