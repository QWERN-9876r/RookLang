// RookUI Card: a title, an optional icon and text; CardGrid (card-grid.rk) lays cards out in
// columns.

import styles from "./card.module.css"
import { Icon, IconName } from "./icon.rk"

export comp Card(title string, icon ?IconName = null, children Content) {
    return <article class={styles.card}>
        {icon != null ? <span class={styles.icon}><Icon name={icon} size={20} /></span> : null}
        <h3 class={styles.title}>{title}</h3>
        <div class={styles.body}>{children}</div>
    </article>
}
