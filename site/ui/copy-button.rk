// RookUI CopyButton: copies a text and shows for a moment that it did.

import { IconButton } from "./icon-button.rk"

/** A button that copies `text` and shows for a moment that it did. */
export comp CopyButton(text string, label string = "Copy", doneLabel string = "Copied") {
    state copied = false

    func copy() {
        navigator.clipboard.writeText(text).then(() => {
            copied = true
            setTimeout(() => {
                copied = false
            }, 1500)
        })
    }

    return <IconButton
        icon={copied ? "check" : "copy"}
        label={copied ? doneLabel : label}
        size="sm"
        onClick={copy()}
    />
}
