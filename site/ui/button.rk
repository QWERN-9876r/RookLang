// RookUI Button, a <button>, and the kinds and sizes of all the buttons (link-button.rk,
// icon-button.rk, icon-link.rk). The attributes of the element (`onClick`, `disabled`, `type`,
// `aria-*`...) go on it through ...attrs.

import styles from "./button.module.css"
import { Icon, IconName } from "./icon.rk"

export type ButtonKind "primary" | "secondary" | "ghost"

export type ButtonSize "sm" | "md" | "lg"

export comp Button(
    kind ButtonKind = "secondary",
    size ButtonSize = "md",
    icon ?IconName = null,
    children Content,
    ...attrs
) {
    return <button class={`${styles.button} ${styles[kind]} ${styles[size]}`} type="button" {...attrs}>
        {icon != null ? <Icon name={icon} /> : null}
        {children}
    </button>
}
