// RookUI drawer: a panel over the page, for a menu on narrow screens. `open` is bound: Escape, the
// close button and a click beside the panel close it, and `bind:open` tells the parent.

import styles from "./drawer.module.css"
import { IconButton } from "./icon-button.rk"

export comp Drawer(bind open bool = false, label string, closeLabel string, children Content) {
    effect {
        if open {
            const close = (event KeyboardEvent) => {
                if event.key == "Escape" {
                    open = false
                }
            }
            window.addEventListener("keydown", close)
            defer window.removeEventListener("keydown", close)
        }
    }

    return <div class={[styles.drawer, open ? styles.open : null]}>
        <div class={styles.backdrop} onClick={open = false} />
        <div class={styles.panel} role="dialog" aria-modal="true" aria-label={label}>
            <div class={styles.top}>
                <IconButton icon="close" label={closeLabel} onClick={open = false} />
            </div>
            {children}
        </div>
    </div>
}
