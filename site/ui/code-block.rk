// RookUI CodeBlock: highlighted code (the children), with a button that copies its text.

import styles from "./code-block.module.css"
import { CopyButton } from "./copy-button.rk"

export comp CodeBlock(
    code string,
    label string = "",
    copyLabel string = "Copy",
    copiedLabel string = "Copied",
    children Content,
) {
    return <figure class={styles.block}>
        <figcaption class={styles.header}>
            <span>{label}</span>
            <CopyButton text={code} label={copyLabel} doneLabel={copiedLabel} />
        </figcaption>
        <pre class={styles.code}>{children}</pre>
    </figure>
}
