// Code highlighting with the compiler's own lexer: Rook tokens are marked as the compiler
// sees them. The generated JS is marked by the same lexer too, with its own keywords: the syntax is
// almost the same. Only the lexer is imported: the rest of the compiler is loaded on first use
// (compiler.ts), and the code is highlighted as soon as the page is drawn.

import { tokenize } from "../../src/lexer/lexer.ts"
import { KEYWORDS } from "../../src/lexer/token.ts"
import { highlightCss } from "./highlight-css.rk"
import "./highlight.module.css"

// In the compiler, KEYWORDS is an array of literal types ("func" | "comp" | ...), and here it is
// compared with any strings.
const ROOK_KEYWORDS []string = [...KEYWORDS]

const ROOK_TYPES = [
    "number", "bigint", "byte", "string", "bool", "any", "error", "void", "Content",
    "int8", "uint8", "int16", "uint16", "int32", "uint32", "int64", "uint64", "float32", "float64",
]

const JS_KEYWORDS = [
    "function", "return", "if", "else", "for", "of", "in", "while", "do", "const", "let", "var",
    "new", "class", "extends", "throw", "try", "catch", "finally", "switch", "case", "default",
    "break", "continue", "import", "export", "from", "typeof", "instanceof", "this", "super",
    "static", "async", "await", "yield",
]

const LITERALS = ["true", "false", "null", "undefined"]

// Modifiers of class members and parameters, before a name: private readonly id string, and bind
// before a property of a component that it may change, bind active string
const MODIFIERS = ["private", "protected", "static", "readonly", "bind"]

// What follows public when it is a modifier: public state x, public func f(), public name string
const PUBLIC_NEXT = ["Identifier", "const", "let", "func", "async"]

// What starts the type of the values after queue or topic, besides a name: queue ?string
const MADE_TYPE_NEXT = ["?", "[", "(", "<-", "func", "comp", "chan"]

// Between tokens are spaces and comments; split with a group keeps the comments in the result.
const COMMENT = new RegExp("(//[^\\n]*|/\\*[\\s\\S]*?\\*/)")

export func highlight(code string, language string) DocumentFragment {
    const fragment = <></>
    let tokens any
    try {
        tokens = tokenize(code).tokens
    } catch {
        fragment.append(code)
        return fragment
    }
    let pos = 0
    for i, token in tokens {
        // Semicolons inserted by the lexer and the end of the file take no room in the text.
        if token.text == "" {
            continue
        }
        if token.start > pos {
            appendGap(fragment, code.slice(pos, token.start))
        }
        const kind = tokenClass(tokens, i, language)
        if token.kind == "CssText" {
            fragment.append(highlightCss(token.text))
        } else if kind == "" {
            fragment.append(token.text)
        } else {
            fragment.append(<span class={kind}>{token.text}</span>)
        }
        pos = token.end
    }
    if pos < code.length {
        appendGap(fragment, code.slice(pos))
    }
    return fragment
}

func appendGap(fragment DocumentFragment, text string) {
    for i, part in text.split(COMMENT) {
        if part == "" {
            continue
        }
        if i % 2 == 1 {
            fragment.append(<span class="com">{part}</span>)
        } else {
            fragment.append(part)
        }
    }
}

func tokenClass(tokens any, i number, language string) string {
    const token = tokens[i]
    const kind string = token.kind
    const text string = token.text
    // After a dot, any name is a property, even if it is a keyword: event.type
    if i > 0 && (tokens[i - 1].kind == "." || tokens[i - 1].kind == "?.") {
        return tokens[i + 1].kind == "(" ? "fn" : ""
    }
    if isDecorator(tokens, i) {
        return "fn"
    }
    if language != "js" && (isNeeds(tokens, i) || isIncludes(tokens, i) || isWithKey(tokens, i)) {
        return "kw"
    }
    if language != "js" && (isNeeded(tokens, i) || isIncluded(tokens, i)) {
        return "fn"
    }
    switch kind {
    case "Number", "BigInt":
        return "num"
    case "String", "RegExp", "Template", "TemplateHead", "TemplateMiddle", "TemplateTail", "JsxString":
        return "str"
    case "JsxText":
        return ""
    case "JsxTagOpen", "JsxCloseTagOpen", "JsxTagEnd", "JsxSelfClose":
        return "tag"
    case "JsxName":
        const previous string = tokens[i - 1].kind
        if previous == "JsxTagOpen" || previous == "JsxCloseTagOpen" {
            // <section.content /> takes a component from a value
            return isCapitalized(text) || text.includes(".") ? "type" : "tag"
        }
        return "attr"
    case "Identifier":
        if language != "js" && isMadeType(tokens, i) || isAccessor(tokens, i) {
            return "kw"
        }
        return identifierClass(text, tokens[i + 1].kind, language)
    }
    if LITERALS.includes(text) {
        return "lit"
    }
    if ROOK_KEYWORDS.includes(kind) {
        return "kw"
    }
    return ""
}

func identifierClass(text string, next string, language string) string {
    if language == "js" {
        if JS_KEYWORDS.includes(text) {
            return "kw"
        }
        if LITERALS.includes(text) {
            return "lit"
        }
    } else {
        if ROOK_TYPES.includes(text) {
            return "type"
        }
        // state, derived, ref, mount, effect, style and dec are keywords only at the start of a
        // declaration: state count = 0, ref input, mount { }, effect { }, style { },
        // dec visible() { }; so is public, in classes and decorators, and select before {
        if (text == "state" || text == "derived" || text == "ref") && next == "Identifier" ||
            (text == "mount" || text == "effect" || text == "style" || text == "select") && next == "{" {
            return "kw"
        }
        // data is a keyword only before class, data class Point, and so is abstract, also before
        // a member: abstract area() number; the other modifiers before a member or a parameter
        if text == "dec" && next == "Identifier" || text == "public" && PUBLIC_NEXT.includes(next) ||
            text == "data" && next == "class" ||
            text == "abstract" && (next == "class" || next == "Identifier") ||
            MODIFIERS.includes(text) && next == "Identifier" {
            return "kw"
        }
        // value as Type, and delete before what it removes
        if text == "as" && next != "=" && next != ")" || text == "delete" && next == "Identifier" {
            return "kw"
        }
    }
    // decode<User>(body) is a call
    if next == "(" || text == "decode" && next == "<" && language != "js" {
        return "fn"
    }
    return isCapitalized(text) ? "type" : ""
}

// queue and topic are types before the type of their values, queue number, and before the < of
// queue<T>() written without a space; elsewhere they are names: queue < n
func isMadeType(tokens any, i number) bool {
    const next = tokens[i + 1]
    if tokens[i].text != "queue" && tokens[i].text != "topic" {
        return false
    }
    if next.kind == "<" {
        return next.start == tokens[i].end
    }
    return next.kind == "Identifier" && next.text != "as" || MADE_TYPE_NEXT.includes(next.kind)
}

// get and set before the name of a method are a getter and a setter: get area() number; get() is a
// method named get
func isAccessor(tokens any, i number) bool {
    const text = tokens[i].text
    return (text == "get" || text == "set") && tokens[i + 1].kind == "Identifier" &&
        tokens[i + 2].kind == "("
}

// @html-tag is the tokens @, html, - and tag, written without spaces.
func isDecorator(tokens any, i number) bool {
    for let j = i; j >= 0 && j >= i - 3; j-- {
        if tokens[j].kind == "@" {
            return true
        }
        if j == 0 || tokens[j - 1].end != tokens[j].start {
            return false
        }
    }
    return false
}

// needs is a keyword only after the parameters of a decorator: dec cartBadge() needs cart, auth {
func isNeeds(tokens any, i number) bool {
    return tokens[i].text == "needs" && i > 0 && tokens[i - 1].kind == ")" &&
        tokens[i + 1].kind == "Identifier"
}

// The decorators after needs: cart and auth in needs cart, auth
func isNeeded(tokens any, i number) bool {
    if tokens[i].kind != "Identifier" {
        return false
    }
    let j = i - 1
    for j > 0 && tokens[j].kind == "," && tokens[j - 1].kind == "Identifier" &&
        !isNeeds(tokens, j - 1) {
        j -= 2
    }
    return j > 0 && isNeeds(tokens, j)
}

// includes is a keyword only after the parameters or the needs of a decorator:
// dec shop(n number) includes counter(n), cart {
func isIncludes(tokens any, i number) bool {
    return tokens[i].text == "includes" && i > 0 &&
        (tokens[i - 1].kind == ")" || tokens[i - 1].kind == "Identifier") &&
        tokens[i + 1].kind == "Identifier"
}

// The decorators after includes: counter and cart in includes counter(n), cart
func isIncluded(tokens any, i number) bool {
    if tokens[i].kind != "Identifier" {
        return false
    }
    let j = i - 1
    for j > 0 && tokens[j].kind == "," {
        j--
        if tokens[j].kind == ")" {
            j = openingParen(tokens, j) - 1
        }
        if j < 0 || tokens[j].kind != "Identifier" {
            return false
        }
        j--
    }
    return j > 0 && isIncludes(tokens, j)
}

// The ( that the ) at i closes, or -1
func openingParen(tokens any, i number) number {
    let depth = 0
    for let j = i; j >= 0; j-- {
        if tokens[j].kind == ")" {
            depth++
        } else if tokens[j].kind == "(" {
            depth--
            if depth == 0 {
                return j
            }
        }
    }
    return -1
}

func isCapitalized(text string) bool {
    const first = text.charAt(0)
    return first != first.toLowerCase()
}

// with key are keywords only together, after the items of a list: for todo in todos with key todo.id
func isWithKey(tokens any, i number) bool {
    const text string = tokens[i].text
    return text == "with" && tokens[i + 1].text == "key" ||
        text == "key" && i > 0 && tokens[i - 1].text == "with"
}
