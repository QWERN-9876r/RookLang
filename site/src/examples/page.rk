// The page of examples, laid out as the examples of PixiJS: the list of examples on the left, and
// next to it the code of the one chosen beside its result. Each example has an address of its own,
// `examples/search/`, and the links of the list change it without loading the page again.

import "../../ui/theme.rk"
import { text } from "../i18n.rk"
import { sectionIn, sectionLinks, withSections } from "../sections.rk"
import { SiteHeader } from "../layout/header.rk"
import { previewArea } from "../sandbox.rk"
import { CaseView } from "./case-view.rk"
import styles from "./page.module.css"

/** An example: its anchor, title and a line about it, and its program in site/examples. */
export interface Case {
    id string
    title string
    description string
    example string
}

comp ExamplesPage(cases []Case) {
    const t = text()
    const ids = cases.map(each => each.id)
    state current = Math.max(0, sectionIn(ids, location.pathname))
    // One area for all the examples: running one stops the one shown before.
    const preview = previewArea()

    func update() {
        current = Math.max(0, sectionIn(ids, location.pathname))
        document.title = `${cases[current].title} — ${t.examplesTitle}`
    }

    mount() {
        update()
        return sectionLinks(ids, update)
    }

    return <>
        <SiteHeader wide={true} />
        <main class={styles.layout}>
            <nav class={styles.sidebar} aria-label={t.examplesPage}>
                <h1 class={styles.heading}>{t.examplesPage}</h1>
                <ul class={styles.list}>
                    {for i, each in cases {
                        <li>
                            <a
                                class={styles.item}
                                href={`../${each.id}/`}
                                aria-current={i == current ? "page" : null}
                            >
                                <strong>{each.title}</strong>
                                <span>{each.description}</span>
                            </a>
                        </li>
                    }}
                </ul>
            </nav>
            <div class={styles.frame}>
                {for i, each in cases {
                    if i == current {
                        <CaseView name={each.example} preview={preview} />
                    }
                }}
            </div>
        </main>
    </>
}

/** Draws the page, again if the build drew it for search engines; see renderDocs(). */
export func renderExamples(cases []Case) {
    withSections(cases.map(each => each.id))
    document.body.replaceChildren(<ExamplesPage cases={cases} />)
}
