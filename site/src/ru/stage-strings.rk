// Тексты сцены раздела на русском. В подписи текст между обратными кавычками — код.

import { StageStrings } from "../stage/strings.rk"

export const STAGE StageStrings = {
    lead: "Вертикали доски — горутины и каналы. Каждое сообщение — ход по горизонтали.",
    javascript: "JavaScript",
    startLabel: "начало партии",
    start: "На доске одна ладья, `main`. Каналы пусты.",
    moveLabel: (move, count, who) => `ход ${move} из ${count} · ${who}`,
    won: "1–0",
    stalemateLabel: "пат · ½–½",
    stalemateWord: "ПАТ",
    stalemate: "Все ждут друг друга, ходов нет. Программа зависнет.",
    hint: "Нажмите на число в коде. При буфере 1 партия закончится патом.",
    hintStalemate: "Пат. Нажмите на число ещё раз, чтобы поменять буфер.",
    liveNumber: value => `Буфер канала: ${value}. Нажмите, чтобы изменить`,
    play: "Сыграть партию",
    pause: "Пауза",
    timeline: "Ход партии",
    labels: {
        waits: "ждёт",
        finished: "закончил",
        closed: "закрыт",
        noBuffer: "без буфера",
        buffer: size => `буфер ${size}`,
    },
    pulse: {
        title: "Одно состояние. Два обновления.",
        lead: "Измените значение и проследите импульс по графу зависимостей. Обновятся только DOM-узлы, которые его читают; независимая подпись останется на месте.",
        change: "Изменить count",
        reset: "Сбросить",
        ready: value => `Готово · count = ${value}`,
        changed: value => `count: ${value} · обновлены 2 узла`,
        source: "Код на Rook",
        graph: "Граф зависимостей",
        preview: "Живое превью DOM",
        state: "состояние",
        button: "текст кнопки",
        paragraph: "абзац",
        independent: "всегда здесь",
        updated: "обновлённые узлы вспыхивают",
    },
    go: (task, args) => `\`go\` ставит на доску новую ладью: ${task} выполняется в своём потоке${args == null ? "." : `, получив копии (${args}).`}`,
    returnResult: (from, to, value) => `${from} возвращает \`${value}\` горутине ${to}.`,
    select: who => `${who} подсвечивает все готовые ветки \`select\`, а затем выполняет одну из них.`,
    turn: (task, phase) => `Асинхронная задача ${task} ${phase == "wait" ? "ждёт" : "возобновляется"} в том же потоке.`,
    publish: (topic, value) => `\`${topic} <- ${value}\` рассылает копию всем подписчикам.`,
    cancel: task => `Вызывающая горутина берёт ${task}: его выполнение отменено.`,
    waitReceive: (who, channel) => `${who} ждёт значения из \`${channel}\`: канал пуст.`,
    waitNoBuffer: (who, channel) => `${who} отправляет в \`${channel}\`. Буфера нет, поэтому ${who} ждёт получателя.`,
    waitFull: (who, channel) => `${who} отправляет в \`${channel}\`, но буфер полон. ${who} ждёт места.`,
    handSend: (channel, value, to) => `\`${channel} <- ${value}\`: ${to} уже ждал и получает значение сразу.`,
    handReceive: (channel, to, value, from) => `\`<-${channel}\`: ${to} встречается с ${from}, который ждал, и забирает ${value}.`,
    intoBuffer: (channel, value, used, size) => `\`${channel} <- ${value}\`: никто не ждёт, значение ложится в буфер. Занято ${used} из ${size}.`,
    outOfBuffer: (who, value, channel) => `${who} берёт ${value} из буфера \`${channel}\`.`,
    close: channel => `\`close(${channel})\`: значений больше не будет. То, что в буфере, ещё можно получить.`,
    end: who => `Канал закрыт и пуст: цикл ${who} закончился.`,
    endMain: "Все результаты получены. Партия сыграна.",
}
