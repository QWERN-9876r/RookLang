// Раздел «Что такое Rook» русского гайда; разделы перечислены в guide.rk.

import { Example } from "../../example.rk"
import { Card } from "../../../ui/card.rk"
import { CardGrid } from "../../../ui/card-grid.rk"

export comp Intro() {
    return <>
        <p>
            Rook — язык с семантикой JavaScript, синтаксисом в духе Go и статической
            типизацией. Его главная особенность — горутины: <code>go f(x)</code> запускает функцию в
            отдельном потоке, на другом процессоре, а каналы передают значения между ними, как в Go.
            Он компилируется в читаемый JavaScript: что написано, то и выполняется, а то, чего JS
            не умеет сам, например каналы, делает маленький рантайм.
        </p>
        <CardGrid>
            <Card title="Горутины и каналы" icon="cpu">
                <code>go f(x)</code> запускает функцию на другом процессоре, а каналы и
                {" "}<code>select</code> связывают горутины: см. <a href="#goroutines">Горутины</a>.
            </Card>
            <Card title="Как в JavaScript" icon="layers">
                Те же значения, объекты, массивы, классы и модули. Можно использовать любые
                JS-библиотеки.
            </Card>
            <Card title="Как в Go" icon="code">
                <code>func</code>, тип после имени, несколько результатов, ошибки вторым значением,
                {" "}<code>defer</code> и один цикл <code>for</code>.
            </Card>
            <Card title="Типы" icon="shield">
                Компилятор проверяет программу до запуска, включая <code>null</code>: значение типа
                {" "}<code>?User</code> нельзя использовать без проверки.
            </Card>
            <Card title="Разметка и компоненты" icon="zap">
                <code>&lt;button&gt;</code> в коде создаёт настоящий DOM-элемент, а компонент с
                {" "}<code>state</code> сам обновляет свою разметку.
            </Card>
        </CardGrid>
        <p>
            У каждого примера есть вкладка <b>JavaScript</b> — это код, который генерирует
            компилятор, запущенный прямо на этой странице. <b>Запустить</b> выполняет пример,
            а <b>В песочницу</b> открывает его в редакторе внизу страницы.
        </p>
        <Example name="hello" />
    </>
}
