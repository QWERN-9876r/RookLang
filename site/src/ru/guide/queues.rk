// Раздел «Очереди» русского гайда; разделы перечислены в guide.rk.

import { Example } from "../../example.rk"

export comp Queues() {
    return <>
        <p>
            <code>queue T</code> хранит значения по порядку, и они входят и выходят с обоих концов:
            {" "}<code>push</code> и <code>unshift</code> добавляют, <code>shift</code> и
            {" "}<code>pop</code> вынимают, <code>at(-1)</code> смотрит на последнее. В массиве
            {" "}<code>shift()</code> сдвигает все остальные значения, а очередь держит их кольцом,
            поэтому взять первое значение стоит одинаково для десяти значений и для миллиона.
            {" "}<code>queue&lt;T&gt;()</code> создаёт пустую очередь,
            {" "}<code>queue&lt;T&gt;(items)</code> — очередь со значениями массива, а пустая
            очередь — нулевое значение.
        </p>
        <Example name="queues" />
    </>
}
