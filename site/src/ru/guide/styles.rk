// Раздел «Стили» русского гайда; разделы перечислены в guide.rk.

import { Example } from "../../example.rk"
import { highlight } from "../../highlight.rk"

const CSS_MODULE = `import styles from "./button.module.css"

type Kind "primary" | "ghost"

export comp Button(kind Kind = "primary", pressed bool = false, children Content) {
    return <button
        class={[styles.button, styles[kind], pressed ? styles.pressed : null]}
        aria-pressed={pressed}
    >
        {children}
    </button>
}`

export comp Styles() {
    return <>
        <p>
            <code>{"style { ... }"}</code> в теле компонента — CSS для его собственной разметки.
            Элементы этой разметки получают класс компонента, и каждый селектор тоже, так что
            {" "}<code>.track</code> здесь не задевает другие полосы на странице, а стили других
            компонентов не задевают эти элементы.
        </p>
        <Example name="styles" />
        <ul>
            <li>
                <code>{"{expr}"}</code> в значении объявления берётся из кода. Значение становится
                CSS-переменной элемента, который возвращает компонент, и следует за состоянием,
                как разметка: нажмите кнопку.
            </li>
            <li>
                Разметка, переданная как <code>children</code>, и разметка других компонентов
                сохраняют свои стили; <code>:global(...)</code> делает селектор общим для всей
                страницы.
            </li>
            <li>
                Селектор, который не совпадает ни с одним элементом разметки, — предупреждение
                компилятора: обычно опечатка или элемент из другого компонента.
            </li>
            <li>
                <code>style</code> может быть и у декоратора — для разметки его обёртки.
            </li>
        </ul>
        <p>
            Основной способ стилизовать компоненты — CSS-модуль рядом с ними, обычный файл
            {" "}<code>.css</code>. Компилятор читает его: классы получают собственные имена, а
            {" "}<code>styles</code> — типизированный объект этих имён, поэтому
            {" "}<code>styles.buton</code> — ошибка компиляции, а <code>styles[kind]</code>
            проверяется по типу <code>kind</code>. CSS попадает на страницу вместе с модулем, и в
            {" "}<code>rook build</code>, и в Vite; в песочнице файлов нет, поэтому здесь только
            код:
        </p>
        <pre class="code">{highlight(CSS_MODULE, "rook")}</pre>
        <p>
            Несколько классов — это список: <code>null</code> и пустые строки из него выпадают,
            поэтому класс по условию — это <code>{"pressed ? styles.pressed : null"}</code>.
        </p>
    </>
}
