// Раздел «Состояние» русского гайда; разделы перечислены в guide.rk.

import { Example } from "../../example.rk"

export comp Reactivity() {
    return <>
        <p>
            <code>state</code> объявляет переменную, от которой зависит разметка. Компилятор знает,
            какие части разметки её читают и где она меняется, и после каждого изменения обновляет
            ровно эти части. Подписок и сравнения DOM нет — это видно во вкладке
            {" "}<b>JavaScript</b>.
        </p>
        <Example name="counter" />
        <p>
            <code>bind:value</code> и <code>bind:checked</code> связывают поле ввода с состоянием в
            обе стороны.
        </p>
        <Example name="bind" />
        <p>
            <code>{"{if ...}"}</code> и <code>{"{for ...}"}</code> тоже обновляются. Ветка создаётся
            заново, только когда меняется условие, а блоки списка находятся по самому элементу
            массива и переставляются, а не создаются заново.
        </p>
        <Example name="todos" />
        <p>
            У списка, который приходит заново новыми объектами с теми же данными, например
            загруженного с сервера ещё раз, нет оставшихся элементов, поэтому все его блоки
            создаются заново, и компоненты в них теряют состояние. <code>with key fruit.id</code>
            {" "}после элементов находит блоки по ключу, строке или числу: отметьте фрукт в обоих
            списках и загрузите их заново.
        </p>
        <Example name="keys" />
        <p>
            <code>derived</code> объявляет значение, вычисленное из состояния, только для чтения.
            Когда состояние меняется, значение вычисляется заново прямо перед обновлением разметки,
            которая его читает. Значение, для которого нужно несколько операторов, — блок, который
            его возвращает: <code>{"derived note { ...; return text }"}</code>. <code>effect</code> выполняет свой код, когда разметка создана, и
            снова, когда меняется то, что он читает; убирает за собой через <code>defer</code>,
            который выполняется перед следующим запуском эффекта и при удалении компонента.
        </p>
        <Example name="derived" />
    </>
}
