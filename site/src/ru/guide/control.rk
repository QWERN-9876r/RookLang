// Раздел «Условия и циклы» русского гайда; разделы перечислены в guide.rk.

import { Example } from "../../example.rk"

export comp Control() {
    return <>
        <p>
            Условия и циклы — как в Go: без скобок вокруг условия и всегда с фигурными скобками.
            Цикл один — <code>for</code>: перебор массива, цикл с условием и классический цикл с
            тремя частями. Он перебирает и <code>Map</code> — по ключам и значениям, — и
            {" "}<code>Set</code>, и типизированный массив, к которому можно обращаться по индексу,
            как к массиву. В <code>switch</code> нет <code>break</code>: каждая ветка заканчивается
            сама.
        </p>
        <Example name="control" />
    </>
}
