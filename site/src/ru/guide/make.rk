// Раздел «make» русского гайда; разделы перечислены в guide.rk.

import { Example } from "../../example.rk"

export comp Make() {
    return <>
        <p>
            <code>make(T)</code> — значение типа, которое вычисляет компилятор, поэтому в JS не
            остаётся никаких типов: <code>make(Song)</code> — это
            {" "}<code>{'{ title: "", seconds: 0 }'}</code>, <code>make(Song[])</code> —
            {" "}<code>[]</code>, <code>make(Seconds)</code> для <code>type Seconds number</code> —
            {" "}<code>0</code>.
        </p>
        <p>
            Интерфейс даёт объект своих полей, у каждого своё значение; поле, которого может не
            быть, <code>?T</code> или <code>any</code>, опускается. Литеральный тип даёт свой
            литерал, <code>Map</code> и <code>Set</code> пустые, а класс, конструктор которого
            ничего не принимает, — <code>new Cart()</code>. Каждый <code>make</code> — новое
            значение. У union, функции, интерфейса с методами и типа, который сам себе поле, своего
            значения нет: компилятор объясняет почему.
        </p>
        <p>
            В обобщённой функции <code>make(T)</code> — значение типа каждого вызова,
            {" "}<code>{"fill<Song>(2)"}</code> или выведенного из аргументов. Функция, вызванная с
            одним типом, получает значение прямо в теле; вызванная с несколькими или
            экспортированная — принимает перед своими параметрами функцию, которая его создаёт;
            нигде не вызванная не попадает в JS, и компилятор предупреждает об этом.
            {" "}<code>{"decode<T>"}</code> получает свой тип так же
            (<a href="../decode/">decode</a>).
        </p>
        <Example name="make" />
    </>
}
