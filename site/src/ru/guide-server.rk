// Разделы русского гайда о программах на сервере; все разделы перечислены в guide.rk.

import { CodeBlock } from "../../ui/code-block.rk"
import { example } from "../example.rk"
import { highlight } from "../highlight.rk"
import { text } from "../i18n.rk"

export comp Decode() {
    return <>
        <p>
            Типы стираются, поэтому у значения извне, тела запроса или файла, тот тип, который ему
            приписала программа, и никто его не проверяет. <code>{"decode<Order>(body)"}</code>
            {" "}проверяет его во время работы: компилятор записывает тип в JS как данные, а рантайм
            сверяет с ним значение. Результат — <code>(Order, error)</code>, как у любой функции,
            которая может не сработать.
        </p>
        <p>
            <code>string</code> — это JSON-текст: его разбирают, потом проверяют; значение типа
            {" "}<code>any</code>, например <code>await response.json()</code>, только проверяют.
            Подходящее значение возвращается как есть, вместе с полями, которых нет в типе.
            Отсутствующее поле — ошибка, если оно не nullable, а ошибка говорит, где значение не
            подошло: <code>items[1]: expected string, got 3</code>. Типы, которые JSON не умеет
            хранить, например класс, <code>Date</code> или <code>Map</code>, — ошибка компиляции.
        </p>
        {example("decode")}
    </>
}

export comp Try() {
    return <>
        <p>
            JS-код сообщает об ошибках, бросая их, среди прочих <code>readFileSync</code> из Node и
            {" "}<code>JSON.parse</code>. <code>try expr</code> превращает то, что бросило выражение,
            в ошибку — второе значение, так, как возвращает ошибки код на Rook:
            {" "}<code>const text, err = try readFileSync(path, "utf8")</code>. Он ловит всё, что
            брошено в выражении после него, а с <code>await</code> внутри — и отклонённый Promise:
            {" "}<code>try await fetch(url)</code>.
        </p>
        <p>
            Выражение без значения, например <code>try writeFileSync(path, text)</code>, даёт одну
            ошибку; вызов с результатом <code>(User, error)</code> даёт тот же
            {" "}<code>(User, error)</code>, так что одна проверка покрывает оба способа сломаться.
            {" "}<code>try</code>, ошибку которого не сохранили, — ошибка компиляции.
        </p>
        {example("try")}
    </>
}

export comp AsyncIterables() {
    const t = text()

    return <>
        <p>
            <code>for v in x</code> перебирает и асинхронное итерируемое, значения которого приходят
            из <code>[Symbol.asyncIterator]()</code> в его <code>.d.ts</code>: поток Node, строки
            {" "}<code>readline</code>, тело запроса, курсор базы данных. Цикл компилируется в
            {" "}<code>for await</code> из JS, поэтому каждое значение ждёт своего Promise, как
            значения канала, и цикл разрешён там, где разрешён <code>await</code>.
            {" "}<code>break</code> закрывает поток.
        </p>
        <p>
            Типы берутся из объявлений TypeScript, например <code>@types/node</code>, которых нет у
            песочницы на этой странице, поэтому здесь — код и то, во что он компилируется:
        </p>
        <CodeBlock code={STREAM_ROOK} label="errors.rk" copyLabel={t.copy} copiedLabel={t.copied}>
            {highlight(STREAM_ROOK, "rook")}
        </CodeBlock>
        <CodeBlock code={STREAM_JS} label="errors.js" copyLabel={t.copy} copiedLabel={t.copied}>
            {highlight(STREAM_JS, "js")}
        </CodeBlock>
    </>
}

export comp Signals() {
    const t = text()

    return <>
        <p>
            Сервер останавливается, когда ему говорит менеджер процессов, сигналом, а запрос —
            когда уходит его клиент, через <code>AbortSignal</code>. И то и другое становится
            каналом, чтобы <code>select</code> ждал их вместе с остальным, как
            {" "}<code>signal.Notify</code> и <code>Done()</code> у контекста в Go.
        </p>
        <p>
            <code>signal("SIGINT", "SIGTERM")</code> — канал, в который приходит имя каждого
            сигнала. Пока он слушает, сигналы не завершают процесс, и он держит программу, пока его
            не закроют, как <code>tick</code>:
        </p>
        <CodeBlock code={SHUTDOWN} label="server.rk" copyLabel={t.copy} copiedLabel={t.copied}>
            {highlight(SHUTDOWN, "rook")}
        </CodeBlock>
        <p>
            <code>done(request.signal)</code> получает причину отмены <code>AbortSignal</code> и
            после этого закрывается; <code>abortSignal(stop)</code> — <code>AbortSignal</code>,
            который отменяется, когда в канал приходит значение или канал закрывается, для
            {" "}<code>{"fetch(url, { signal })"}</code> и других API, которые его принимают.
            Сигналы есть только в Node, а эти две функции работают и в браузере:
        </p>
        {example("cancel")}
    </>
}

const STREAM_ROOK = `import { createReadStream } from "node:fs"
import { createInterface } from "node:readline"

async func countErrors(path string) number {
    let errors = 0
    for line in createInterface({ input: createReadStream(path) }) {
        if line.includes("ERROR") {
            errors++
        }
    }
    return errors
}`

const STREAM_JS = `import { createReadStream } from "node:fs";
import { createInterface } from "node:readline";

async function countErrors(path) {
  let errors = 0;
  for await (const line of createInterface({ input: createReadStream(path) })) {
    if (line.includes("ERROR")) {
      errors++;
    }
  }
  return errors;
}`

const SHUTDOWN = `import { createServer } from "node:http"

const stop = signal("SIGINT", "SIGTERM")
const server = createServer(handle).listen(8080)
console.log("stopping on", <-stop)
close(stop)
server.close()`
