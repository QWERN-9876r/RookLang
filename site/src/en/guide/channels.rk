// The section "Channels" of the English guide; guide.rk lists the sections.

import { Example } from "../../example.rk"
import { GoNote } from "../../source-language.rk"
import { CHANNELS } from "../../stage/channels.rk"
import { Stage } from "../../stage/stage.rk"

export comp Channels() {
    return <>
        <p>
            Channels pass values between goroutines, as in Go: <code>{"chan<number>(10)"}</code> makes a
            channel with room for ten numbers, <code>{"ch <- v"}</code> sends a value and waits
            until the channel takes it, <code>{"<-ch"}</code> receives one, and
            {" "}<code>for v in ch</code> receives them until <code>close(ch)</code>. Both ends
            wait, so they work in async functions. A channel can go to goroutines in other threads:
            what passes through it is copied. <code>{"<-chan number"}</code> only receives and <code>{"chan<- string"}</code> only sends: a function that takes one
            cannot use it the other way.
        </p>
        <GoNote message="Unlike Go, a channel send or receive suspends an async function, so write `await` around channel operations when calling the Channel methods; the `<-` shorthand handles it for you." />
        <p>
            In the board's background work, one channel carries task commands to a worker and
            another carries its results back. The channel operations let the sender and receiver
            wait for each other without sharing the board's memory.
        </p>
        <p>
            A channel that the module makes and never closes is a warning: a line with
            {" "}<code>close(ch)</code>, or a function of the module that closes the channel it is
            given, is enough. A <code>chan number</code> without a value is
            {" "}<code>Channel.EMPTY</code>, which is closed: receiving gives <code>0</code> at
            once (see "Channel and Topic" below).
        </p>
        <Example name="channels" />
    </>
}

/** The scene above the section: its program played on the board, move by move. */
export comp ChannelsStage() {
    return <Stage title="Channels" program={CHANNELS} />
}
