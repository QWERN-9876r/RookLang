// The section "What is Rook" of the English guide; guide.rk lists the sections.

import { Example } from "../../example.rk"
import { Card } from "../../../ui/card.rk"
import { CardGrid } from "../../../ui/card-grid.rk"
import { Markup } from "./markup.rk"
import { Goroutines } from "./goroutines.rk"

export comp Intro() {
    return <>
        <p>
            Rook is a language with the semantics of JavaScript, Go-style syntax and static
            types. Its main feature is goroutines: <code>go f(x)</code> runs a function in a thread
            of its own, on another processor, and channels pass values between them, as in Go. It
            compiles to readable JavaScript: what you write is what runs, and what JS cannot do
            alone, such as channels, a small runtime does.
        </p>
        <CardGrid>
            <Card title="Goroutines and channels" icon="cpu">
                <code>go f(x)</code> runs a function on another processor, and channels and
                {" "}<code>select</code> connect goroutines: see <a href="../goroutines/">Goroutines</a>.
            </Card>
            <Card title="Like JavaScript" icon="layers">
                The same values, objects, arrays, classes and modules. Any JS library can be used.
            </Card>
            <Card title="Like Go" icon="code">
                <code>func</code>, the type after the name, several results, errors as a second
                value, <code>defer</code> and a single <code>for</code> loop.
            </Card>
            <Card title="Types" icon="shield">
                The compiler checks the program before it runs, <code>null</code> included: a
                {" "}<code>?User</code> cannot be used without a check.
            </Card>
            <Card title="Markup and components" icon="zap">
                <code>&lt;button&gt;</code> in code creates a real DOM element, and a component with
                {" "}<code>state</code> updates its markup by itself.
            </Card>
        </CardGrid>
        <p>
            Every example has a <b>JavaScript</b> tab with the code generated by the compiler, which
            runs right on this page. <b>Run</b> runs the example, and <b>Open in playground</b>
            {" "}opens it in the editor at the bottom of the page.
        </p>
        <Example name="hello" />
    </>
}
