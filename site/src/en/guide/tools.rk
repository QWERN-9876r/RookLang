// The section "Tools" of the English guide; guide.rk lists the sections.

import { CodeBlock } from "../../../ui/code-block.rk"
import { MARKETPLACE, OPEN_VSX, REPOSITORY, text } from "../../i18n.rk"

const COMMANDS = `npm install rooklang
npx rook build app.rk            # app.js next to the source
npx rook build src --out-dir dist   # every module of a folder
npx rook run app.rk              # compile and run
npx rook run --watch app.rk      # and again on every change
npx rook build app.rk --markup   # with markup and components`

const REPOSITORY_COMMANDS = `npm run site:dev         # this site on the Vite dev server
npm run vscode:install   # the VS Code extension from the source`

export comp Tools() {
    return <>
        <p>
            The compiler is the npm package <code>rooklang</code>, and it runs on Node.js 24. The
            {" "}compiled code imports the runtime, <code>rooklang/runtime</code>, so the package is
            {" "}a dependency of the project:
        </p>
        <CodeBlock
            code={COMMANDS}
            label={text().terminal}
            copyLabel={text().copy}
            copiedLabel={text().copied}
        >
            {COMMANDS}
        </CodeBlock>
        <p>
            Vite projects have a plugin, <code>rooklang/vite</code>: with it <code>.rk</code>
            modules are imported like any others, and type errors show up over the page. This site
            is built that way; its <code>package.json</code> turns markup and components on.
        </p>
        <p>
            For VS Code there is the extension <a href={MARKETPLACE}>Rook Language</a>:
            highlighting, errors as you type and completion. VSCodium, Cursor and other editors
            take it from <a href={OPEN_VSX}>Open VSX</a>.
        </p>
        <p>
            The compiler is written in TypeScript; the source code is in the
            {" "}<a href={REPOSITORY}>GitHub repository</a>. The language specification with the
            reasons for its decisions is in <code>docs/spec.md</code>, the design of components in
            {" "}<code>docs/components.md</code>. This page is written in Rook too: its code
            is in <code>site/src</code>, and the server is <code>site/server.rk</code>. From the
            root of the repository:
        </p>
        <CodeBlock
            code={REPOSITORY_COMMANDS}
            label={text().terminal}
            copyLabel={text().copy}
            copiedLabel={text().copied}
        >
            {REPOSITORY_COMMANDS}
        </CodeBlock>
    </>
}
