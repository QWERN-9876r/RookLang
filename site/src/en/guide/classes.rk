// The section "Classes and interfaces" of the English guide; guide.rk lists the sections.

import { Example } from "../../example.rk"

export comp Classes() {
    return <>
        <p>
            Classes are as in TypeScript: typed fields, <code>constructor</code>,
            {" "}<code>extends</code>, the <code>private</code> and <code>protected</code> modifiers.
        </p>
        <p>
            Interfaces are structural: a class or an object fits if it has the fields and methods.
            {" "}<code>implements</code> only asks the compiler to check that where the class is
            declared.
        </p>
        <Example name="classes" />
        <p>
            Getters and setters are written as in JS, with <code>get</code> and <code>set</code>,
            and are read and assigned as fields. A <code>readonly</code> field is assigned only in
            the constructor, and a constructor parameter with <code>private</code>,
            {" "}<code>public</code> or <code>readonly</code> is a field too. An
            {" "}<code>abstract</code> class has no instances of its own; its abstract methods have
            no body, and each subclass implements them.
        </p>
        <Example name="class-members" />
    </>
}
