// The section "Functions" of the English guide; guide.rk lists the sections.

import { Example } from "../../example.rk"

export comp Functions() {
    return <>
        <p>
            A function is declared with <code>func</code>. Parameters of the same type can be listed
            together, and a function can have several results, unpacked into several variables.
        </p>
        <p>
            Literals <code>{"func(x number) number { ... }"}</code> and arrow functions
            {" "}<code>x =&gt; x * 2</code> compile to JS arrow functions, so <code>this</code> in
            them is the one outside. Such a function in the initializer of a variable runs after
            the initializer, so it can use the variable: a recursive literal, or a callback that
            stops its own timer. If the type of the function depends on its body, as for
            {" "}<code>{"const f = () => f()"}</code>, the variable needs a written type.
        </p>
        <p>
            Parameters at the end may have default values, <code>times = 1</code>, and the last
            one may take the rest of the arguments in an array, <code>...prices []number</code>, as
            in JS. A function before a template, <code>{"money`${120}`"}</code>, is its tag: it
            gets the strings and the values, which are checked against its parameters.
        </p>
        <Example name="functions" />
    </>
}
