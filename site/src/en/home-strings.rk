// Texts of the English home page.

import { HomeStrings } from "../i18n.rk"

export const HOME HomeStrings = {
    newLabel: "New",
    news: "go for: a loop over an array on every core",
    title: "JavaScript on",
    titleAccent: "every core.",
    lead: "Rook is a language with the semantics of JavaScript, the syntax of Go and static types. The word go runs a function on another processor, channels connect the goroutines, and it all compiles to readable JavaScript.",
    openPlayground: "Open playground",
    watchGame: "Watch this program move by move",
    lanesTitle: "One thread, or every core.",
    lanesLead: "go for splits an array into parts, several per processor, runs each part as a goroutine on the first free core and waits for all of them. The same loop, one word longer.",
    oneThread: "one thread",
    goFor: "every core",
    faster: "faster",
    lanesNote: "Measured with Node on a machine with 14 cores: a rook for each core where the screen has the room.",
    replay: "Replay",
    goForArray: "10,000,000 numbers",
    goForMoment: "The moment of the scene",
    goForSteps: (one, all, ratio) => [
        "primes is an array of ten million numbers. Each one has to be checked.",
        "for: one thread walks the array from its start to its end.",
        `Done in ${one} ms. Now the same loop with the word go.`,
        "go for splits the array into parts and puts a goroutine on each.",
        "All the parts are computed at the same time, and main waits.",
        `Done in ${all} ms: ${ratio.toFixed(1)} times faster.`,
    ],
    ms: time => `${time} ms`,
    ratio: ratio => `${ratio.toFixed(1)}×`,
    featuresTitle: "The ideas of Go, in JavaScript.",
    featuresLead: "Threads, channels and types that know about them, in a language that compiles to plain JavaScript for the browser and Node.",
    goroutinesTitle: "Goroutines on real threads",
    goroutinesText: "go f(x) runs a function in a pool of Web Workers or worker threads, one per processor, and gives a Promise of its result. No worker files, no messages written by hand.",
    channelsTitle: "Channels and select",
    channelsText: "Goroutines in any thread pass values through channels, wait on several at once and stop waiting with after(ms), as in Go.",
    channelsMore: "Watch it move by move",
    typesTitle: "Types that know about threads",
    typesText: "A function, a class or a DOM element cannot be copied to another thread. The compiler says so before the program runs.",
    jsText: "Each construct becomes the JavaScript you would write by hand. What channels and goroutines need comes from a small runtime, imported by name.",
    componentsTitle: "Components in the browser",
    componentsText: "comp, state and markup compile to direct calls of the DOM, without a virtual DOM. This counter is a component of this page:",
    serverTitle: "Components on the server",
    serverText: "The same markup writes a server: there it is a string of HTML, a component is an async function, and the root answers a request. Experimental until 1.0.",
    clicks: count => `Clicked ${count} ${count == 1 ? "time" : "times"}`,
    toolsTitle: "Tools included",
    toolsText: "A CLI that builds and runs, a Vite plugin, an extension for VS Code with errors as you type and completion, and .d.ts files for TypeScript.",
    compareTitle: "Write Rook. Ship JavaScript.",
    compareGoroutines: "Goroutines",
    compareComponents: "Components",
    compareErrors: "Errors",
    startTitle: "Start in a minute.",
    startLead: "The compiler is an npm package and runs on Node.js 24.",
    startInstall: "Install",
    startWrite: "Write",
    startRun: "Run",
    startCode: `func greet(name string) string {
    return \`Hello, \${name}!\`
}

console.log(greet("Rook"))`,
    startOutput: "Hello, Rook!",
    ctaTitle: "Start with the guide.",
    ctaMove: "your move",
    ctaLead: "From variables to goroutines and components, with examples you can run right on the page.",
