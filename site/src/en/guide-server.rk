// The sections of the English guide about programs on a server; guide.rk lists them all.

import { CodeBlock } from "../../ui/code-block.rk"
import { example } from "../example.rk"
import { highlight } from "../highlight.rk"
import { text } from "../i18n.rk"

export comp Decode() {
    return <>
        <p>
            The types are erased, so a value from outside, the body of a request or a file, has the
            type that the program says it has, and nothing checks it.
            {" "}<code>{"decode<Order>(body)"}</code> checks it when the program runs: the compiler
            writes the type into the JS as data, and the runtime checks the value against it. The
            result is <code>(Order, error)</code>, as of any function that may fail.
        </p>
        <p>
            A <code>string</code> is JSON text: it is parsed, then checked; a value of type
            {" "}<code>any</code>, such as <code>await response.json()</code>, is only checked. A
            value that fits is returned as it is, with the fields that the type does not have. A
            missing field is an error unless it is nullable, and the error says where the value does
            not fit: <code>items[1]: expected string, got 3</code>. Types that JSON cannot hold,
            such as a class, <code>Date</code> or <code>Map</code>, are a compile error.
        </p>
        {example("decode")}
    </>
}

export comp Try() {
    return <>
        <p>
            JS code reports errors by throwing them, Node's <code>readFileSync</code> and
            {" "}<code>JSON.parse</code> among them. <code>try expr</code> turns what the expression
            throws into an error, the second value, as Rook code returns errors:
            {" "}<code>const text, err = try readFileSync(path, "utf8")</code>. It catches
            everything thrown in the expression after it, and with <code>await</code> in it a
            rejected Promise too: <code>try await fetch(url)</code>.
        </p>
        <p>
            An expression that gives nothing, such as <code>try writeFileSync(path, text)</code>,
            gives the error alone; a call of <code>(User, error)</code> gives the same
            {" "}<code>(User, error)</code>, so one check covers both ways to fail. A
            {" "}<code>try</code> whose error is not kept is a compile error.
        </p>
        {example("try")}
    </>
}

export comp AsyncIterables() {
    const t = text()

    return <>
        <p>
            <code>for v in x</code> goes over an async iterable too, whose values come from
            {" "}<code>[Symbol.asyncIterator]()</code> of its <code>.d.ts</code>: a stream of Node,
            the lines of <code>readline</code>, the body of a request, the cursor of a database. It
            compiles to <code>for await</code> of JS, so each value waits for its Promise, as the
            values of a channel do, and the loop is allowed where <code>await</code> is.
            {" "}<code>break</code> closes the stream.
        </p>
        <p>
            The types come from TypeScript declarations, such as <code>@types/node</code>, which the
            playground on this page does not have, so here is the code with what it compiles to:
        </p>
        <CodeBlock code={STREAM_ROOK} label="errors.rk" copyLabel={t.copy} copiedLabel={t.copied}>
            {highlight(STREAM_ROOK, "rook")}
        </CodeBlock>
        <CodeBlock code={STREAM_JS} label="errors.js" copyLabel={t.copy} copiedLabel={t.copied}>
            {highlight(STREAM_JS, "js")}
        </CodeBlock>
    </>
}

export comp Signals() {
    const t = text()

    return <>
        <p>
            A server stops when the process manager tells it to, with a signal, and a request stops
            when its client goes, with an <code>AbortSignal</code>. Both become channels, so that
            {" "}<code>select</code> waits for them with the rest, as <code>signal.Notify</code> and
            the <code>Done()</code> of a context do in Go.
        </p>
        <p>
            <code>signal("SIGINT", "SIGTERM")</code> is a channel that gets the name of each signal.
            While it listens, the signals do not end the process, and it keeps the program running
            until it is closed, as a <code>tick</code> does:
        </p>
        <CodeBlock code={SHUTDOWN} label="server.rk" copyLabel={t.copy} copiedLabel={t.copied}>
            {highlight(SHUTDOWN, "rook")}
        </CodeBlock>
        <p>
            <code>done(request.signal)</code> gets the reason of an <code>AbortSignal</code> when it
            aborts, and is closed then; <code>abortSignal(stop)</code> is an
            {" "}<code>AbortSignal</code> that aborts when the channel gets a value or is closed,
            for <code>{"fetch(url, { signal })"}</code> and the other APIs that take one. Signals
            are of Node, and these two work in the browser too:
        </p>
        {example("cancel")}
    </>
}

const STREAM_ROOK = `import { createReadStream } from "node:fs"
import { createInterface } from "node:readline"

async func countErrors(path string) number {
    let errors = 0
    for line in createInterface({ input: createReadStream(path) }) {
        if line.includes("ERROR") {
            errors++
        }
    }
    return errors
}`

const STREAM_JS = `import { createReadStream } from "node:fs";
import { createInterface } from "node:readline";

async function countErrors(path) {
  let errors = 0;
  for await (const line of createInterface({ input: createReadStream(path) })) {
    if (line.includes("ERROR")) {
      errors++;
    }
  }
  return errors;
}`

const SHUTDOWN = `import { createServer } from "node:http"

const stop = signal("SIGINT", "SIGTERM")
const server = createServer(handle).listen(8080)
console.log("stopping on", <-stop)
close(stop)
server.close()`
