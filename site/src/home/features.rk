// What Rook has, as a grid of cards of different sizes, each with a glimpse of it: small boards
// that play `go`, select and the border between threads (small-board.rk), a counter that is a
// real component, a component of a server, and the tools.

import { Icon, IconName } from "../../ui/icon.rk"
import { highlight } from "../highlight.rk"
import { sectionHref, text } from "../i18n.rk"
import { Reveal } from "../layout/reveal.rk"
import { GO_SCENE } from "../stage/small-go.rk"
import { SELECT_SCENE } from "../stage/small-select.rk"
import { TYPES_SCENE } from "../stage/small-types.rk"
import { GOROUTINE, SELECT_CASES, SERVER, TYPE_ERROR } from "./code.rk"
import common from "./section.module.css"
import styles from "./features.module.css"
import { Feature } from "./feature.rk"
import { Counter } from "./counter.rk"
import { SmallBoard } from "./small-board.rk"

interface Tool {
    icon IconName
    label string
}

const TOOLS Tool[] = [
    { icon: "terminal", label: "rook build" },
    { icon: "terminal", label: "rook run" },
    { icon: "package", label: "rooklang/vite" },
    { icon: "code", label: "VS Code" },
    { icon: "layers", label: ".d.ts" },
]

export comp Features() {
    const h = text().home
    return <section class={common.section}>
        <div class={common.container}>
            <Reveal>
                <div class={common.heading}>
                    <h2>{h.featuresTitle}</h2>
                    <p>{h.featuresLead}</p>
                </div>
            </Reveal>
            <Reveal>
                <div class={styles.grid}>
                    <Feature title={h.goroutinesTitle} body={h.goroutinesText} icon="cpu" span="two">
                        <SmallBoard scene={GO_SCENE} tall={true}>
                            <pre class={styles.line}>{highlight(GOROUTINE, "rook")}</pre>
                        </SmallBoard>
                    </Feature>
                    <Feature title={h.channelsTitle} body={h.channelsText} icon="zap">
                        <SmallBoard scene={SELECT_SCENE}>
                            <pre class={styles.snippet}>
                                {highlight("select {", "rook")}
                                <span class={styles.first}>{highlight(SELECT_CASES[0], "rook")}</span>
                                <span class={styles.second}>{highlight(SELECT_CASES[1], "rook")}</span>
                                {"}"}
                            </pre>
                            <a class={styles.more} href={sectionHref("docs", "select")}>
                                {h.channelsMore}
                                <Icon name="arrow-right" size={14} />
                            </a>
                        </SmallBoard>
                    </Feature>
                    <Feature title={h.typesTitle} body={h.typesText} icon="shield">
                        <SmallBoard scene={TYPES_SCENE}>
                            <pre class={[styles.error, styles.alarm]}>{TYPE_ERROR}</pre>
                        </SmallBoard>
                    </Feature>
                    <Feature title={h.componentsTitle} body={h.componentsText} icon="layers">
                        <Counter />
                    </Feature>
                    <Feature title={h.serverTitle} body={h.serverText} icon="terminal">
                        <pre class={styles.snippet}>{highlight(SERVER, "rook")}</pre>
                    </Feature>
                    <Feature title={h.toolsTitle} body={h.toolsText} icon="package" span="row">
                        <div class={styles.tools}>
                            {for tool in TOOLS {
                                <span class={styles.tool}>
                                    <Icon name={tool.icon} size={14} />
                                    {tool.label}
                                </span>
                            }}
                        </div>
                    </Feature>
                </div>
            </Reveal>
        </div>
    </section>
}
