// The first screen of the home page: what Rook is in one sentence, the ways to the guide and the
// playground and the install, beside a board where a program with goroutines and channels is
// played move by move (stage/). The same scene opens the section "Channels" of the guide.

import { LinkButton } from "../../ui/link-button.rk"
import { CopyButton } from "../../ui/copy-button.rk"
import { Icon } from "../../ui/icon.rk"
import { pageHref, sectionHref, text } from "../i18n.rk"
import { CHANNELS } from "../stage/channels.rk"
import { Stage } from "../stage/stage.rk"
import { INSTALL } from "./code.rk"
import styles from "./hero.module.css"

export comp Hero() {
    const t = text()
    const h = t.home
    return <Stage
        title={t.tagline}
        program={CHANNELS}
        hero={<div class={styles.content}>
            <a class={styles.news} href={sectionHref("docs", "goroutines")}>
                <span class={styles.newLabel}>{h.newLabel}</span>
                {h.news}
                <Icon name="chevron-right" size={14} />
            </a>
            <h1 class={styles.title}>
                <span class={styles.base}>{h.title}</span>
                {" "}
                <span class={styles.accent}>{h.titleAccent}</span>
            </h1>
            <p class={styles.lead}>{h.lead}</p>
            <div class={styles.actions}>
                <LinkButton kind="primary" size="lg" href={pageHref("docs")}>
                    {t.getStarted}
                    <Icon name="arrow-right" size={16} />
                </LinkButton>
                <LinkButton size="lg" href={pageHref("playground")} icon="play">
                    {h.openPlayground}
                </LinkButton>
            </div>
            <div class={styles.install}>
                <span class={styles.prompt} aria-hidden="true">$</span>
                <code>{INSTALL}</code>
                <CopyButton text={INSTALL} label={t.copy} doneLabel={t.copied} />
            </div>
            <a class={styles.more} href={sectionHref("docs", "channels")}>
                {h.watchGame}
                <Icon name="arrow-right" size={14} />
            </a>
        </div>}
    />
}
