// The small board of `select`: `main` stands between two channels, a line that may be played is
// lit to each, and the one that is ready first is played. In one round a message comes; in the
// next the time of after(500) runs out. The mark of a frame is the case being played, 1 or 2.

import { FRONT, project } from "./camera.rk"
import { IVORY, clamp, colourOf, ease, lerp, mix, rgba } from "./paint.rk"
import { grab, standing } from "./poses.rk"
import { drawPoses } from "./rook-shape.rk"
import { Brush, SmallScene, drawDashes, drawLine, drawName, drawSpark, drawTile } from "./small.rk"

/** When the timer of after(500) starts, and how long it takes to run out, in seconds. */
const TIMER_START = 0.4
const TIMER = 2.1

func drawSelect(brush Brush, t number, cycle number) number {
    const ctx = brush.ctx
    const view = brush.view
    const timeout = cycle % 2 == 1
    // The moment a case is ready, the side it comes from, and its colour.
    const at = timeout ? TIMER_START + TIMER : 1.3
    const from = timeout ? 1 : -1
    const colour = colourOf(timeout ? 2 : 1)
    const played = t >= at
    const way = lerp(from, 0, ease(clamp((t - at) / 0.5)))
    const gone = clamp((t - at - 0.45) / 0.3)
    const open = clamp(t / 0.4)

    for side in [-1, 1] {
        if played && side == from {
            drawLine(brush, side, way, colour, 1 - gone)
        } else {
            drawDashes(brush, side * 0.3, side, IVORY, open * (played ? 1 - clamp((t - at) / 0.3) : 1))
        }
        // A channel is a ring on its file.
        const point = project(view, side, FRONT)
        const radius = 0.26 * point.scale
        const lit = played && side == from ? 1 - gone : 0
        ctx.strokeStyle = rgba(mix(IVORY, colour, lit), 0.35 + 0.65 * lit)
        ctx.lineWidth = 1.5 + 2 * lit
        ctx.beginPath()
        ctx.ellipse(point.x, point.y, radius, radius * 0.3, 0, 0, Math.PI * 2)
        ctx.stroke()
        if side == 1 {
            // The ring of after(500) fills as its time goes; a message that comes first stops it.
            const until = timeout ? t : Math.min(t, at)
            const fade = played ? 1 - clamp((t - at - (timeout ? 0.45 : 0)) / 0.3) : 1
            ctx.strokeStyle = rgba(colourOf(2), 0.95 * fade)
            ctx.lineWidth = 2.5
            ctx.beginPath()
            ctx.ellipse(point.x, point.y, radius, radius * 0.3, 0, -Math.PI / 2, -Math.PI / 2 + clamp((until - TIMER_START) / TIMER) * Math.PI * 2)
            ctx.stroke()
        }
    }
    if played && gone < 1 {
        // A message is a value; the end of the time carries none.
        if timeout {
            drawSpark(brush, way, colour, 1 - gone)
        } else {
            drawTile(brush, way, "\"hi\"", colour, 1 - gone, gone)
        }
    }

    const main = standing(view, 0, 0)
    main.wait = open * (1 - clamp((t - at - 0.4) / 0.2))
    main.alpha = 1 - 0.4 * main.wait
    grab(main, clamp((t - at - 0.42) / 0.5), -from)
    drawPoses(ctx, [main], brush.moving, brush.now)
    drawName(brush, -1, "messages", IVORY, 0.8)
    drawName(brush, 0, "main", colourOf(0))
    drawName(brush, 1, "after(500)", IVORY, 0.8)
    return played && t < at + 1.6 ? (timeout ? 2 : 1) : 0
}

export const SELECT_SCENE SmallScene = { files: 3, period: 4.6, rest: 1.1, draw: drawSelect }
