// The program of the scene of the section "Channels": two goroutines square the numbers that
// `main` sends through a channel with a buffer. The reader changes the size of the buffer, and
// with too small a one the game ends in a stalemate. The lines of the traces in pilot.rk are the
// lines of this code.

import { MAX_BUFFER, pilotTrace } from "./pilot.rk"
import { Program } from "./stage.rk"

export const CHANNELS Program = {
    lines: [
        "async func square(",
        "    id number,",
        "    jobs <-chan number,",
        "    results chan<- string,",
        ") {",
        "    for n in jobs {",
        "        results <- `#${id}: ${n}² = ${n * n}`",
        "    }",
        "}",
        "",
        "const jobs = chan<number>(§)",
        "const results = chan<string>()",
        "",
        "go square(1, jobs, results)",
        "go square(2, jobs, results)",
        "",
        "for let n = 1; n <= 4; n++ {",
        "    jobs <- n",
        "}",
        "close(jobs)",
        "",
        "for let i = 0; i < 4; i++ {",
        "    console.log(<-results)",
        "}",
    ],
    initial: 2,
    // The first click gives 1, a stalemate; then 0, and round from the largest buffer.
    next: value => value == 0 ? MAX_BUFFER : value - 1,
    trace: pilotTrace,
}
