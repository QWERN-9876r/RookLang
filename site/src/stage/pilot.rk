const EVENTS Event[][] = [BUFFER_0, BUFFER_1, BUFFER_2, BUFFER_3, BUFFER_4]

/** The largest buffer of `jobs` that has a trace. */
export const MAX_BUFFER = EVENTS.length - 1

/** The game of the pilot program with `buffer` places in `jobs`. */
export func pilotTrace(buffer number) Trace {
    const size = Math.max(0, Math.min(MAX_BUFFER, buffer))
    return {
        actors: [
            { id: "main", label: "main" },
            { id: "square-1", label: "square 1" },
            { id: "square-2", label: "square 2" },
        ],
        channels: [
            { id: "jobs", label: "jobs", size: size },
            { id: "results", label: "results", size: 0 },
        ],
        events: EVENTS[size],
    }
}
