// The guide: /docs/ is the language map; each section address, `docs/goroutines/`, opens one
// section at a time. The links between sections change the address without loading the page again.
// All sections stay in the page, the others hidden, so that the search finds their text. A section
// may open with a scene (stage/), which is as wide as the page and stands above the text.

import "../../ui/theme.rk"
import { Icon } from "../../ui/icon.rk"
import { NavGroup, NavList } from "../../ui/nav-list.rk"
import { Prose } from "../../ui/prose.rk"
import { REPOSITORY, Section, SectionStage, text } from "../i18n.rk"
import { sectionIn, sectionLinks, withSections } from "../sections.rk"
import { SiteHeader } from "../layout/header.rk"
import styles from "./page.module.css"
import { clearVisited, LanguageMap, markVisited, visitedSections } from "./map.rk"
import { SearchButton } from "./search-button.rk"
import { SearchDialog } from "./search-dialog.rk"

/** The sections in the groups of the tree, in order. */
func navGroups(sections Section[]) NavGroup[] {
    const groups NavGroup[] = []
    for section in sections {
        const last = groups.at(-1)
        const link = { id: section.id, title: section.title }
        if last != null && last.title == section.group {
            last.links.push(link)
        } else {
            groups.push({ title: section.group, links: [link] })
        }
    }
    return groups
}

comp DocsPage(sections Section[], stages SectionStage[]) {
    const t = text()
    const groups = navGroups(sections)
    const ids = sections.map(each => each.id)
    state current = sectionIn(ids, location.pathname)
    state visited = visitedSections(ids)
    state searching = false

    // A new section starts at the top of the page, with its name in the title of the tab.
    func update() {
        const next = sectionIn(ids, location.pathname)
        if next != current {
            current = next
            window.scrollTo(0, 0)
        }
        if next >= 0 {
            document.title = `${sections[next].title} — ${t.docsTitle}`
            visited = markVisited(sections[next].id, visited)
        } else {
            document.title = t.docsTitle
        }
    }

    func currentId() string {
        return current >= 0 ? sections[current].id : ""
    }

    func mapPosition() string {
        return current >= 0 ? sections[current].id : visited.at(-1) ?? sections[0].id
    }

    func resetProgress() {
        clearVisited()
        visited = []
    }

    // ⌘K or Ctrl+K opens the search anywhere, and / where nothing is being typed.
    func onKey(event KeyboardEvent) {
        const typing = event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement
        if (event.key == "k" && (event.metaKey || event.ctrlKey)) || (event.key == "/" && !typing) {
            event.preventDefault()
            searching = true
        }
    }

    mount {
        update()
        const stop = sectionLinks(ids, update)
        window.addEventListener("keydown", onKey)
        defer {
            stop()
            window.removeEventListener("keydown", onKey)
        }
    }

    return <>
        <SiteHeader
            tools={<SearchButton onOpen={searching = true} />}
            menu={<NavList
                groups={groups}
                active={currentId()}
                label={t.sections}
                hrefOf={id => current < 0 ? `./${id}/` : `../${id}/`}
            />}
        />
        <SearchDialog bind:open={searching} sections={sections} />
        <div class={current < 0 ? styles.mapLayout : styles.layout}>
            {if current >= 0 {
                <aside class={styles.sidebar}>
                    <NavList
                        groups={groups}
                        active={currentId()}
                        label={t.sections}
                        hrefOf={id => `../${id}/`}
                    />
                </aside>
            }}
            <main class={current < 0 ? styles.mapMain : styles.main}>
                {if current < 0 {
                    <LanguageMap
                        sections={sections}
                        current={mapPosition()}
                        visited={visited}
                        onClear={resetProgress}
                    />
                } else {
                    <>
                        {for stage in stages {
                            if stage.id == currentId() {
                                <div data-stage={stage.id}>
                                    <stage.content />
                                </div>
                            }
                        }}
                        <div class={styles.content}>
                            {for each in sections {
                                <article
                                    class={styles.article}
                                    data-section={each.id}
                                    hidden={each.id != currentId()}
                                >
                                    <div class={styles.breadcrumb}>
                                        {each.group}
                                        <Icon name="chevron-right" size={14} />
                                        <span>{each.title}</span>
                                    </div>
                                    <Prose>
                                        <h1>{each.title}</h1>
                                        <each.content />
                                    </Prose>
                                </article>
                            }}
                            <nav class={styles.pager} aria-label={t.sections}>
                                {if current > 0 {
                                    <a class={styles.previous} href={`../${sections[current - 1].id}/`}>
                                        <span class={styles.direction}>
                                            <Icon name="chevron-left" size={14} />
                                            {t.previous}
                                        </span>
                                        <span class={styles.name}>{sections[current - 1].title}</span>
                                    </a>
                                }}
                                {if current < sections.length - 1 {
                                    <a class={styles.next} href={`../${sections[current + 1].id}/`}>
                                        <span class={styles.direction}>
                                            {t.next}
                                            <Icon name="chevron-right" size={14} />
                                        </span>
                                        <span class={styles.name}>{sections[current + 1].title}</span>
                                    </a>
                                }}
                            </nav>
                            <p class={styles.footer}>
                                {t.footerWritten}{" "}<a href={REPOSITORY}>GitHub</a>
                            </p>
                        </div>
                    </>
                }}
            </main>
        </div>
    </>
}

/**
 * Draws the page; the entry module of the language calls it after setLanguage(). The page may be
 * there already, drawn when the site was built for search engines: it is drawn again, alive.
 */
export func renderDocs(sections Section[], stages SectionStage[]) {
    withSections(sections.map(each => each.id), true)
    document.body.replaceChildren(<DocsPage sections={sections} stages={stages} />)
}
