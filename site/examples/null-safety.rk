interface Todo {
    title string
    done bool
}

const todos []Todo = [{ title: "Buy guavas", done: false }]

// find returns ?Todo: there may be no such task
const todo = todos.find(t => t.title == "Buy guavas")

// console.log(todo.done) is a compile error: todo may be null
if todo != null {
    console.log(todo.done)     // here todo is already a Todo
}

// x! takes a value not to be null, as in TypeScript; nothing is checked at runtime,
// so a check or ?? is safer
const first = todos.find(t => !t.done)!
console.log(first.title, todo?.title ?? "none")

// A function whose result is never does not return: after its call, todo is a Todo
func fail(message string) never {
    throw error(message)
}
if todo == null {
    fail("no such task")
}
console.log(todo.title)
