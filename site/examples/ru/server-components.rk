// Сервер отдаёт одну модель задач как HTML или JSON; в package.json
// пакета стоит "rook": { "markup": "html" }.
import { reply, serve } from "rooklang/server"

type Priority "low" | "normal" | "high"

interface Task {
    id string
    title string
    done bool
    priority Priority
}

const TASKS Task[] = [
    { id: "model", title: "Описать модель задачи", done: true, priority: "normal" },
    { id: "board", title: "Вывести доску задач", done: false, priority: "high" },
]

async func loadTasks() Task[] {
    return TASKS
}

comp Layout(title string, children Content) {
    return <html lang="ru">
        <head><title>{title}</title></head>
        <body><main>{children}</main></body>
    </html>
}

comp TaskRows(tasks Task[]) {
    return <ul>{for task in tasks {
        <li>
            <label>
                <input type="checkbox" checked={task.done} />
                {task.title} <small>{task.priority}</small>
            </label>
        </li>
    }}</ul>
}

comp TaskPage() {
    const tasks = await loadTasks()
    return <Layout title="Доска задач">
        <h1>Доска задач</h1><TaskRows tasks={tasks} />
    </Layout>
}

comp App(request Request) {
    const path = new URL(request.url).pathname
    if path == "/api/tasks" {
        return await loadTasks()
    }
    if path == "/" {
        return <TaskPage />
    }
    return reply("Не найдено", { status: 404 })
}

serve(App, { port: 3000 })
