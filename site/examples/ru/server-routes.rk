// route() связывает путь со страницей: :id пути — это свойство id,
// и компилятор сверяет одно с другим
import { reply, route, Route, serve } from "rooklang/server"

// Обёртка, которая принимает Content, получает тело: граница ошибок
dec fallback(message string) {
    return (page Content<Html | Response>) => {
        const value, err = try await page()
        if err != null {
            console.error(err)
            return <p class="error">{message}</p>
        }
        return value
    }
}

comp Home() {
    return <h1>Заказы</h1>
}

@fallback("Этот заказ нельзя показать")
comp Order(id string) {
    const n = Number(id)
    if Number.isNaN(n) {
        throw new Error(`не число: ${id}`)
    }
    return <h1>Заказ №{n}</h1>
}

const ROUTES Route<Html | Response>[] = [
    route("/", Home),
    route("/orders/:id", Order),
    // route("/orders/:number", Order) было бы ошибкой:
    // Order has no property "number" for ":number"
]

comp App(request Request) {
    const path = new URL(request.url).pathname
    for each in ROUTES {
        const Page = each.match(path)
        if Page != null {
            return <Page />
        }
    }
    return reply("Не найдено", { status: 404 })
}

serve(App, { port: 3000 })
