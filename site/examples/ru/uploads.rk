// Десять файлов, по три одновременно. Предел — не счётчик, а три
// загрузчика, которые берут файлы из одной очереди, каждый следующий
// только тогда, когда закончил свой. Попытка дольше 2 с прерывается,
// а файл пробуется до трёх раз

interface File {
    name string
    size number                     // КБ
}

const FILES []File = [
    { name: "beach.jpg", size: 1200 },
    { name: "notes.pdf", size: 300 },
    { name: "cat.png", size: 800 },
    { name: "song.mp3", size: 1500 },
    { name: "plan.docx", size: 400 },
    { name: "forest.jpg", size: 1100 },
    { name: "budget.xlsx", size: 250 },
    { name: "talk.mp4", size: 1400 },
    { name: "logo.svg", size: 150 },
    { name: "city.jpg", size: 900 },
]

const TRIES = 3
const TIMEOUT = 2000

// Ненастоящий сервер, 1 мс на КБ: каждая четвёртая попытка падает,
// каждая шестая зависает. В жизни это fetch(url, { body, signal })
async func upload(file File, signal AbortSignal) error {
    const fate = Math.random()
    select {
    case <-after(fate < 1 / 6 ? 60_000 : file.size):
    case <-done(signal):
        return error("время вышло")
    }
    if fate > 0.75 {
        return error("ошибка сервера")
    }
    return null
}

type Status "в очереди" | "загрузка" | "повтор" | "готово" | "ошибка"

interface Row {
    file File
    status Status
    note string
    by number                       // загрузчик, который его взял, до того 0
}

func queued(file File) Row {
    return { file, status: "в очереди", note: "", by: 0 }
}

comp Uploads() {
    state rows = FILES.map(queued)
    state running = false
    derived sent = rows.filter(row => row.status == "готово").length
    derived failed = rows.filter(row => row.status == "ошибка").length

    func set(i number, by number, status Status, note string) {
        rows = rows.map((row, j) => j == i ? { file: row.file, status, note, by } : row)
    }

    // Файл, которым загрузчик занят сейчас, если такой есть
    func busy(by number) ?Row {
        for row in rows {
            if row.by == by && (row.status == "загрузка" || row.status == "повтор") {
                return row
            }
        }
        return null
    }

    // Пробует отправить файл, не больше TRIES раз
    async func deliver(i number, by number) {
        for let attempt = 1; attempt <= TRIES; attempt++ {
            set(i, by, "загрузка", attempt == 1 ? "" : `попытка ${attempt}`)
            const start = performance.now()
            // Сигнал прерывается, когда after() даёт своё значение
            const err = await upload(FILES[i], abortSignal(after(TIMEOUT)))
            if err == null {
                const ms = `${Math.round(performance.now() - start)} мс`
                set(i, by, "готово", attempt == 1 ? ms : `попытка ${attempt}, ${ms}`)
                return
            }
            const last = attempt == TRIES
            set(i, by, last ? "ошибка" : "повтор", err.message)
            if !last {
                <-after(300 * attempt)  // после каждой неудачи дольше
            }
        }
    }

    // Загрузчик берёт файл из очереди и не берёт следующий, пока этот
    // не отправлен или не упал окончательно
    async func uploader(by number, queue <-chan number) {
        for i in queue {
            await deliver(i, by)
        }
    }

    async func start() {
        running = true
        rows = FILES.map(queued)
        const queue = chan<number>(FILES.length)
        for i, _ in FILES {
            queue <- i
        }
        close(queue)                // загрузчики остановятся, когда она опустеет
        // Три загрузчика — значит, три файла одновременно: в этом весь предел
        await Promise.all([uploader(1, queue), uploader(2, queue), uploader(3, queue)])
        running = false
    }

    mount {
        start()
    }

    style {
        .uploads { display: grid; gap: 12px; max-width: 480px; }
        .top { display: flex; align-items: center; gap: 12px; }
        .summary { color: #ffffffb3; font-size: 0.9em; }
        button {
            padding: 6px 14px;
            border: 1px solid #f5a524;
            border-radius: 8px;
            background: #f5a524;
            color: #000;
            font: inherit;
            cursor: pointer;
        }
        button:disabled { opacity: 0.4; cursor: default; }
        .lanes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
        .lane {
            display: grid;
            gap: 2px;
            padding: 8px 10px;
            border-top: 3px solid var(--by);
            border-radius: 8px;
            background: #ffffff0d;
            font-size: 0.85em;
        }
        .lane span { color: #ffffff80; }
        .files { display: grid; gap: 4px; margin: 0; padding: 0; list-style: none; }
        .files li {
            display: grid;
            grid-template-columns: 1fr auto 150px;
            gap: 12px;
            padding: 6px 12px;
            border-left: 3px solid var(--by, transparent);
            border-radius: 8px;
            background: #ffffff0a;
            font-size: 0.9em;
        }
        .size { color: #ffffff59; font-variant-numeric: tabular-nums; }
        .status { text-align: right; }
        [data-by="1"] { --by: #f5a524; }
        [data-by="2"] { --by: #5eb1ff; }
        [data-by="3"] { --by: #c48cff; }
        [data-status="в очереди"] .status { color: #ffffff59; }
        [data-status="загрузка"] .status { color: #ffffff; }
        [data-status="повтор"] .status { color: #f5a524; }
        [data-status="готово"] .status { color: #6fcf8f; }
        [data-status="ошибка"] .status { color: #ff7a7a; }
    }

    return <div class="uploads">
        <div class="top">
            <button disabled={running} onClick={start()}>Загрузить снова</button>
            <span class="summary">{sent} отправлено · {failed} с ошибкой</span>
        </div>
        <div class="lanes">
            {for by in [1, 2, 3] {
                const row = busy(by)
                <div class="lane" data-by={by}>
                    <b>Загрузчик {by}</b>
                    <span>{row != null ? row.file.name : running ? "берёт следующий" : "закончил"}</span>
                </div>
            }}
        </div>
        <ul class="files">
            {for row in rows {
                <li data-status={row.status} data-by={row.by}>
                    <span>{row.file.name}</span>
                    <span class="size">{row.file.size} КБ</span>
                    <span class="status">
                        {row.status}{row.note == "" ? "" : ` · ${row.note}`}
                    </span>
                </li>
            }}
        </ul>
    </div>
}

document.body.append(<Uploads />)
