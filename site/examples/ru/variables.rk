let count number           // без значения — нулевое значение типа: 0
let title = "Гуава"        // тип выведен из значения: string
const prices []number = [120, 90, 250]

let a, b = 1, 2
a, b = b, a                // обмен значениями

count += prices.length
console.log(count, title, a, b)

// Поля объекта раскладываются по переменным, в том числе с другим именем и остаток
const guava = { name: "Гуава", price: 120, stock: 7 }
const { name, price: cost, ...rest } = guava
console.log(name, cost, rest.stock)

// Метод в объектном литерале пишется как в классе
const shop = {
    open: true,
    label(hour number) string {
        return hour < 20 ? "Открыто" : "Закрыто"
    },
}
console.log(shop.label(19))
