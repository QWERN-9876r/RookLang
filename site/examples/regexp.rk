// A regular expression is written as in JS; the compiler checks the pattern and the flags
const date = /^(\d{4})-(\d{2})-(\d{2})$/
const text = "guava, papaya and lychee"

console.log(date.test("2026-10-26"), date.test("26.10.2026"))
console.log(text.replace(/a/g, "o"))
console.log(text.split(/,\s*|\s+and\s+/))
