type Priority "low" | "normal" | "high"

interface Task {
    id number
    title string
    done bool
    priority Priority
}

comp TaskRow(task Task) {
    return <li>
        <label><input type="checkbox" checked={task.done} />{task.title}</label>
        <small>{task.priority}</small>
    </li>
}

const tasks Task[] = [
    { id: 1, title: "Write the task model", done: true, priority: "normal" },
    { id: 2, title: "Build the task board", done: false, priority: "high" },
]

document.body.append(
    <ul>{for task in tasks { <TaskRow task={task} /> }}</ul>,
)
