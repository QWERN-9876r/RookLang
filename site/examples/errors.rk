// An error is the second result, as in Go
func parseAge(text string) (number, error) {
    const age = Number(text)
    if isNaN(age) || age < 0 {
        return 0, error(`"${text}" is not an age`)
    }
    return age, null
}

class Person {
    name string
    age number

    constructor(name string, age number) {
        this.name = name
        this.age = age
    }
}

// A class has no zero value: null goes together with an error
func parsePerson(line string) (Person, error) {
    const parts = line.split(" ")
    const age, err = parseAge(parts[1])
    if err != null {
        return null, err
    }
    return new Person(parts[0], age), null
}

for line in ["Ann 42", "Bob forty-two"] {
    const person, err = parsePerson(line)
    if err != null {
        console.log("error:", err.message)
        continue
    }
    console.log(person.name, "is", person.age) // err is null, so person is not
}
