// derived is a value computed from state: it is computed again when the state changes,
// before the markup that reads it is updated
comp Basket() {
    state prices []number = [3, 2]
    derived total = prices.reduce((sum, price) => sum + price, 0)
    // A block computes it in several steps and returns the value
    derived note {
        const room = 10 - total
        if room <= 0 {
            return "That is a lot of guavas"
        }
        return `There is room for ${room} more`
    }

    // effect runs once the markup is created, and again when what it reads changes
    effect {
        console.log("total:", total)
    }

    return <div>
        <button onClick={prices.push(3)}>Add a guava</button>
        <p>{prices.length} fruits for {total}. {note}</p>
    </div>
}

document.body.append(<Basket />)
