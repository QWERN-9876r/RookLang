{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rook declarations",
  "scopeName": "source.rook.declarations",
  "comment": "Declarations of functions, components, decorators, classes and types, and the modifiers of class members; rook.tmLanguage.json includes them.",
  "patterns": [{ "include": "#declarations" }],
  "repository": {
    "declarations": {
      "patterns": [
        {
          "match": "(?<![\\w$])(?<![^.]\\.)(func)\\s+([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": { "name": "storage.type.function.rook" },
            "2": { "name": "entity.name.function.rook" }
          }
        },
        {
          "comment": "`dec` is a keyword only in a declaration: `dec visible(`.",
          "match": "(?<![\\w$])(?<![^.]\\.)(dec)\\s+([A-Za-z_$][\\w$]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "storage.type.decorator.rook" },
            "2": { "name": "entity.name.function.decorator.rook" }
          }
        },
        {
          "comment": "`needs` is a keyword only after the parameters of a decorator: `dec cartBadge() needs cart, auth {`.",
          "begin": "(?<=\\))\\s*(needs)(?=\\s+[A-Za-z_$])",
          "beginCaptures": { "1": { "name": "storage.modifier.needs.rook" } },
          "end": "(?=\\{|\\s+includes\\s)",
          "patterns": [
            { "name": "entity.name.function.decorator.rook", "match": "[A-Za-z_$][\\w$]*" },
            { "name": "punctuation.separator.comma.rook", "match": "," }
          ]
        },
        {
          "comment": "`includes` is a keyword only after the parameters or the needs of a decorator: `dec shop(n number) includes counter(n), cart {`.",
          "begin": "(?<=[)\\w$])\\s+(includes)(?=\\s+[A-Za-z_$])",
          "beginCaptures": { "1": { "name": "storage.modifier.includes.rook" } },
          "end": "(?=\\{)",
          "patterns": [
            {
              "begin": "\\(",
              "end": "\\)",
              "patterns": [{ "include": "source.rook#statements" }]
            },
            { "name": "entity.name.function.decorator.rook", "match": "[A-Za-z_$][\\w$]*" },
            { "name": "punctuation.separator.comma.rook", "match": "," }
          ]
        },
        {
          "match": "(?<![\\w$])(?<![^.]\\.)(comp)\\s+([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": { "name": "storage.type.component.rook" },
            "2": { "name": "entity.name.type.component.rook" }
          }
        },
        {
          "match": "(?<![\\w$])(?<![^.]\\.)(class)\\s+([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": { "name": "storage.type.class.rook" },
            "2": { "name": "entity.name.type.class.rook" }
          }
        },
        {
          "comment": "Separate from `class Name`: type parameters can come between, `class Stack<T> implements Source<T>`.",
          "match": "(?<![\\w$])(?<![^.]\\.)(extends)\\s+([A-Za-z_$][\\w$.]*)",
          "captures": {
            "1": { "name": "storage.modifier.rook" },
            "2": { "name": "entity.other.inherited-class.rook" }
          }
        },
        {
          "name": "storage.modifier.rook",
          "match": "(?<![\\w$])(?<![^.]\\.)implements(?![\\w$])"
        },
        {
          "match": "(?<![\\w$])(?<![^.]\\.)(interface|type)\\s+([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": { "name": "storage.type.rook" },
            "2": { "name": "entity.name.type.rook" }
          }
        },
        {
          "comment": "`mount {` in a component, like `state`, is a keyword only at the start of a statement.",
          "match": "^\\s*(mount)(?=\\s*\\{)",
          "captures": {
            "1": { "name": "storage.type.mount.rook" }
          }
        },
        {
          "comment": "`effect {` in a component, like `mount {`.",
          "match": "^\\s*(effect)(?=\\s*\\{)",
          "captures": {
            "1": { "name": "storage.type.effect.rook" }
          }
        },
        {
          "comment": "`state`, `derived` and `ref` are keywords only at the start of a statement, followed by a name; a decorator's state may be `public state`, and state of a module `export state`.",
          "match": "(?:^\\s*|(?<=^export\\s))(?:(public)\\s+)?(state|derived|ref)(?=\\s+[A-Za-z_$])",
          "captures": {
            "1": { "name": "storage.modifier.rook" },
            "2": { "name": "storage.type.state.rook" }
          }
        },
        {
          "comment": "Modifiers of class members.",
          "match": "^\\s*((?:static|private|protected|public|readonly|abstract)(?:\\s+(?:static|private|protected|public|readonly|abstract))*)(?=\\s+[A-Za-z_$])",
          "captures": { "1": { "name": "storage.modifier.rook" } }
        },
        {
          "comment": "A constructor parameter that is a property: `constructor(private name string)`; `readonly number` is a parameter named readonly.",
          "match": "(?:(?<=\\()|(?<=,))\\s*((?:private|protected|public|readonly)(?:\\s+(?:private|protected|public|readonly))*)(?=\\s+[A-Za-z_$][\\w$]*\\s+[^\\s,)])",
          "captures": { "1": { "name": "storage.modifier.rook" } }
        },
        {
          "comment": "`bind` before a property of a component that it may change, `comp Tabs(bind active string)`, also at the start of a line; `(bind Mode)` is a parameter named bind.",
          "match": "(?:(?<=\\()|(?<=,)|^)\\s*(bind)(?=\\s+[A-Za-z_$][\\w$]*\\s+[^\\s,)])",
          "captures": { "1": { "name": "storage.modifier.rook" } }
        },
        {
          "comment": "`get area()` and `set area(v number)` in a class; `get()` is a method named get.",
          "match": "(?<![\\w$.])(get|set)\\s+(?=[A-Za-z_$][\\w$]*\\s*\\()",
          "captures": { "1": { "name": "storage.type.property.rook" } }
        },
        {
          "match": "(?<![\\w$])(?<![^.]\\.)(from)(?=\\s*[\"'])",
          "captures": { "1": { "name": "keyword.control.import.rook" } }
        },
        {
          "match": "(\\*)\\s*(as)(?![\\w$])",
          "captures": {
            "1": { "name": "constant.language.import-export-all.rook" },
            "2": { "name": "keyword.control.as.rook" }
          }
        }
      ]
    }
  }
}
